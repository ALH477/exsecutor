{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "bash hooks/adversary-gate.sh",
            "timeout": 30,
            "statusMessage": "adversary-check gate"
          }
        ]
      }
    ]
  }
}
