// A genuine capability-row violation via closure capture.
//
// Under the ORIGINAL Sec 4.2 rule -- substitute positionally with "the
// capability row of the actual argument", resolved by NAME at the call
// site -- this file was ACCEPTED. `cerrado` is a bare function-typed
// parameter: not a named top-level function, not an inline lambda, so
// there was nothing for a row to attach to. That was the finding.
//
// Under the REVISED rule -- rows travel with function-typed VALUES, so a
// function type carries `poscit {...}` -- `cerrado`'s row is written in
// its own type and needs no lookup. This file must now REJECT.
//
// fabrica legitimately owns `rete`, captures it in a returned lambda, and
// says so in its return TYPE. It is correct and must not be flagged.

publica functio fabrica(v: f32, m: Mundus) -> (functio(f32) -> f32 poscit {rete}) poscit rete {
    sub rete = deriva_rete(m);
    redde functio(x: f32) -> f32 { redde envia(rete, x) }
}

publica functio consumidor(x: f32, f: functio(f32) -> f32 poscit {rete}) -> f32 poscit sicut f {
    redde f(x)
}

// exterior declares only `alloc`, but accepts a closure whose type demands
// `rete` and forwards it. The authority is visible in the signature now.
publica functio exterior(v: f32, cerrado: functio(f32) -> f32 poscit {rete}) -> f32 poscit alloc {
    redde consumidor(v, cerrado)
}
