; TEST: emit-exit=5
;
; `loadbits u9`: a bit field is 1 to 8 bits wide (ssa-ir.md 2.7, "any width
; <= 8"); wider is a `load` at a byte boundary. Verifier rule 1 (verify.inc's
; `__bfa_verify_bitsty`); the emitter refuses it by name too (exit 4).
;
; Mutation (run): __bfa_verify_bitsty's `width > 8` test dropped -> emit_ir
; exits 4, not 5.

functio @initium (ptr) -> u8 {
b0:
%0 = param ptr 0
%1 = slot 8 8
%2 = loadbits u9 %1 0 0
%3 = iconst u8 0
ret %3
}
