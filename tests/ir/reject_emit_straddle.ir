; TEST: emit-exit=4
;
; `loadbits u4 %p 0 6`: a field of bits 6..9, MSB-first -- the low two bits
; of byte 0 and the high two of byte 1. ssa-ir.md 2.7 admits a field that
; straddles a byte "if the declaration did", so the VERIFIER passes it
; (rule 1 checks width 1..8 and bit 0..7, both true here); the EMITTER
; refuses it by name, "a field that straddles a byte boundary is not
; implemented" (emit.inc, "Byte order and bit fields"). Nothing needs one:
; DeModFrame's only sub-byte fields, `versio` and `genus`, fill byte 1
; exactly. Exit 4 here, not 5, is the evidence the two layers disagree on
; purpose.
;
; Mutation (run): the straddle test in __bfa_bits_plan dropped -> emit_ir
; exits 0 and the emitted `shr eax, 4294967294` does not assemble.

functio @initium (ptr) -> u8 {
b0:
%0 = param ptr 0
%1 = slot 8 8
%2 = loadbits u4 %1 0 6
%3 = iconst u8 0
ret %3
}
