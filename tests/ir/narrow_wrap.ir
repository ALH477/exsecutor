; TEST: expect-exit=100
;
; Narrow wrapping arithmetic (wire-codec.md D5; ssa-ir.md 2.2): `addw`/`subw`/
; `mulw` at u4, u8, u24, u32 and i8 compute in 64 bits and NORMALISE -- `shl
; 64-N` then `shr` (`sar` for i8) -- so a result past the top is the wrapped
; value, not the 64-bit one. Checks 11-13 are the trapping forms AT the edge
; of their type (u8 200+55 = 255, i8 -100 + -28 = -128, u24 4096*4095 =
; 2^24 - 4096): each must not trap. The trapping forms past the edge are the
; trap_add_*/trap_sub_u8/trap_mul_* fixtures, one abort each.
;
;    1  addw u4  15 + 3      = 2         (inline immediate operand)
;    2  subw u4  2 - 3       = 15
;    3  addw u8  200 + 100   = 44
;    4  subw u8  3 - 5       = 254
;    5  mulw u8  16 * 17     = 16
;    6  addw u24 2^24-1 + 2  = 1
;    7  addw u32 2^32-1 + 1  = 0         (the constant needs `mov rax, imm64`)
;    8  mulw u32 65536*65537 = 65536
;    9  addw i8  100 + 100   = -56
;   10  subw i8  -100 - 100  = 56
;   11  add  u8  200 + 55    = 255       no trap
;   12  add  i8  -100 + -28  = -128      no trap
;   13  mul  u24 4096 * 4095 = 16773120  no trap
;
; Mutation (run): drop the normalisation after the wrapping op -> exit 1
; (15 + 3 stays 18).
;
; A CHECK CHAIN: check k computes one value, compares it with `cmp.eq` at its
; own type -- a 64-bit compare, so a result left non-canonical (bits above
; N-1 wrong) never equals the canonical expected constant -- and on a
; mismatch returns k. All checks right: exit 100.

functio @initium (ptr) -> u8 {
b0:
%0 = param ptr 0
%1 = iconst u4 15
%2 = addw u4 %1 3
%3 = iconst u4 2
%4 = cmp.eq u4 %2 %3
br %4 b2 b1
b1:
%5 = iconst u8 1
ret %5
b2:
%6 = iconst u4 2
%7 = iconst u4 3
%8 = subw u4 %6 %7
%9 = iconst u4 15
%10 = cmp.eq u4 %8 %9
br %10 b4 b3
b3:
%11 = iconst u8 2
ret %11
b4:
%12 = iconst u8 200
%13 = iconst u8 100
%14 = addw u8 %12 %13
%15 = iconst u8 44
%16 = cmp.eq u8 %14 %15
br %16 b6 b5
b5:
%17 = iconst u8 3
ret %17
b6:
%18 = iconst u8 3
%19 = iconst u8 5
%20 = subw u8 %18 %19
%21 = iconst u8 254
%22 = cmp.eq u8 %20 %21
br %22 b8 b7
b7:
%23 = iconst u8 4
ret %23
b8:
%24 = iconst u8 16
%25 = iconst u8 17
%26 = mulw u8 %24 %25
%27 = iconst u8 16
%28 = cmp.eq u8 %26 %27
br %28 b10 b9
b9:
%29 = iconst u8 5
ret %29
b10:
%30 = iconst u24 16777215
%31 = iconst u24 2
%32 = addw u24 %30 %31
%33 = iconst u24 1
%34 = cmp.eq u24 %32 %33
br %34 b12 b11
b11:
%35 = iconst u8 6
ret %35
b12:
%36 = iconst u32 4294967295
%37 = iconst u32 1
%38 = addw u32 %36 %37
%39 = iconst u32 0
%40 = cmp.eq u32 %38 %39
br %40 b14 b13
b13:
%41 = iconst u8 7
ret %41
b14:
%42 = iconst u32 65536
%43 = iconst u32 65537
%44 = mulw u32 %42 %43
%45 = iconst u32 65536
%46 = cmp.eq u32 %44 %45
br %46 b16 b15
b15:
%47 = iconst u8 8
ret %47
b16:
%48 = iconst i8 100
%49 = iconst i8 100
%50 = addw i8 %48 %49
%51 = iconst i8 -56
%52 = cmp.eq i8 %50 %51
br %52 b18 b17
b17:
%53 = iconst u8 9
ret %53
b18:
%54 = iconst i8 -100
%55 = iconst i8 100
%56 = subw i8 %54 %55
%57 = iconst i8 56
%58 = cmp.eq i8 %56 %57
br %58 b20 b19
b19:
%59 = iconst u8 10
ret %59
b20:
%60 = iconst u8 200
%61 = iconst u8 55
%62 = add u8 %60 %61
%63 = iconst u8 255
%64 = cmp.eq u8 %62 %63
br %64 b22 b21
b21:
%65 = iconst u8 11
ret %65
b22:
%66 = iconst i8 -100
%67 = iconst i8 -28
%68 = add i8 %66 %67
%69 = iconst i8 -128
%70 = cmp.eq i8 %68 %69
br %70 b24 b23
b23:
%71 = iconst u8 12
ret %71
b24:
%72 = iconst u24 4096
%73 = iconst u24 4095
%74 = mul u24 %72 %73
%75 = iconst u24 16773120
%76 = cmp.eq u24 %74 %75
br %76 b26 b25
b25:
%77 = iconst u8 13
ret %77
b26:
%78 = iconst u8 100
ret %78
}
