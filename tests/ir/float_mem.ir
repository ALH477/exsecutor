; TEST: expect-exit=200
;
; `load`/`store` with a FLOAT type, nativus order only (ssa-ir.md 2.7).
; Until 2026-09-14 both emitters refused these by name -- a float's width
; field in the IR is 0 (lower/ty.inc: the kind carries the size), and the
; memory access path keyed on width, so `load f64` died as "a width that
; is not a whole number of bytes". This fixture pins the settlement made
; for examples/signaculum: a float in memory is its raw IEEE BIT PATTERN
; (8 bytes for f64, 4 for f32; an f32 in its slot is the low half of the
; f64 slot's layout), and store/load is bit baggage -- mov-shaped, with no
; arithmetic anywhere on the path, so a NaN payload, -0.0's sign and a
; subnormal's bits all survive (subnormales conservata).
;
; maior/minor on a float stay refused by both backends: byte order is an
; integer surface (spec 5.2). reject_emit_float_load_ord.ir and
; reject_emit_float_store_ord.ir pin that refusal; this fixture runs only
; nativus, which on this little-endian host is the LE image, and checks
; 2 and 4 lean on that (a big-endian host would see the bytes swapped and
; exit 2 -- recorded, not hidden).
;
; The 64-byte slot is pre-filled with 0xAA. Every float store is followed
; by a whole-u64 READ-BACK of the image, so the check sees what memory
; holds rather than trusting the float side to agree with itself the way
; a wrong pair could; guards above and below pin the store's extent.
;
; CHECK CHAIN, check k returns k on a mismatch; all 11 right: exit 200.
;
;    1   guard byte 0                    = 0xaa, untouched by the f64 store at 8
;    2   store f64 1.5 nativus at 8; load u64 = 0x3ff8000000000000
;                                         (bits 4609434218613702656)
;    3   load f64 at 8                   == fconst 1.5 (value round trip)
;    4   store f32 2.5 nativus at 16;    load u64 = 0xaaaaaaaa40200000
;        bits of 2.5f in the low half + untouched 0xAA guard above
;    5   load f32 at 16                  == fconst 2.5f
;    6   store f64 -0.0 at 24;           load u64 = 0x8000000000000000
;                                         (fcmp.eq cannot see a sign it lost
;                                          -- -0.0 == 0.0 -- so BITS pin it)
;    7   store f64 bits=1 (the smallest  load u64 = 1   (subnormal bits
;        positive subnormal) at 32;                    through the store)
;    8   load f64 at 32                  == fconst bits=1 (a flush-to-zero
;                                         on load would read 0.0 ~= 5e-324)
;    9   store f64 quiet-NaN payload 1   load u64 = 0x7ff8000000000001
;        at 40;
;   10   load f64 at 40, store f64 at     load u64 = 0x7ff8000000000001
;        48 (load+store round trip);               (payload survives: no
;                                         arithmetic may touch these bits,
;                                         so neither backend may cleanse)
;   11   guard u64 at 56                 = 0xaaaaaaaaaaaaaaaa, untouched
;
; Mutations (run): the f64 store writing big-endian -> exit 2; the f32
; store writing 8 bytes (clobbering the 0xAA above) -> exit 4; the sign
; dropped (a store spelled 0.0 - x) -> exit 6; subnormal flushed at load
; -> exit 8; a NaN payload canonicalised anywhere on the path -> exit 9
; or 10; one byte too many on the last store -> exit 11.

functio @initium (ptr) -> u8 {
b0:
%0 = param ptr 0
%1 = slot 64 8
%2 = iconst u64 12297829382473034410
store u64 %1 0 nativus %2
store u64 %1 8 nativus %2
store u64 %1 16 nativus %2
store u64 %1 24 nativus %2
store u64 %1 32 nativus %2
store u64 %1 40 nativus %2
store u64 %1 48 nativus %2
store u64 %1 56 nativus %2
%3 = fconst f64 4609434218613702656
store f64 %1 8 nativus %3
%4 = fconst f32 1075838976
store f32 %1 16 nativus %4
%5 = fconst f64 9223372036854775808
store f64 %1 24 nativus %5
%6 = fconst f64 1
store f64 %1 32 nativus %6
%7 = fconst f64 9221120237041090561
store f64 %1 40 nativus %7
%8 = load u8 %1 0 nativus
%9 = iconst u8 170
%10 = cmp.eq u8 %8 %9
br %10 b2 b1
b1:
%11 = iconst u8 1
ret %11
b2:
%12 = load u64 %1 8 nativus
%13 = iconst u64 4609434218613702656
%14 = cmp.eq u64 %12 %13
br %14 b4 b3
b3:
%15 = iconst u8 2
ret %15
b4:
%16 = load f64 %1 8 nativus
%17 = fconst f64 4609434218613702656
%18 = fcmp.eq f64 %16 %17
br %18 b6 b5
b5:
%19 = iconst u8 3
ret %19
b6:
%20 = load u64 %1 16 nativus
%21 = iconst u64 12297829380685561856
%22 = cmp.eq u64 %20 %21
br %22 b8 b7
b7:
%23 = iconst u8 4
ret %23
b8:
%24 = load f32 %1 16 nativus
%25 = fconst f32 1075838976
%26 = fcmp.eq f32 %24 %25
br %26 b10 b9
b9:
%27 = iconst u8 5
ret %27
b10:
%28 = load u64 %1 24 nativus
%29 = iconst u64 9223372036854775808
%30 = cmp.eq u64 %28 %29
br %30 b12 b11
b11:
%31 = iconst u8 6
ret %31
b12:
%32 = load u64 %1 32 nativus
%33 = iconst u64 1
%34 = cmp.eq u64 %32 %33
br %34 b14 b13
b13:
%35 = iconst u8 7
ret %35
b14:
%36 = load f64 %1 32 nativus
%37 = fconst f64 1
%38 = fcmp.eq f64 %36 %37
br %38 b16 b15
b15:
%39 = iconst u8 8
ret %39
b16:
%40 = load u64 %1 40 nativus
%41 = iconst u64 9221120237041090561
%42 = cmp.eq u64 %40 %41
br %42 b18 b17
b17:
%43 = iconst u8 9
ret %43
b18:
%44 = load f64 %1 40 nativus
store f64 %1 48 nativus %44
%45 = load u64 %1 48 nativus
%46 = iconst u64 9221120237041090561
%47 = cmp.eq u64 %45 %46
br %47 b20 b19
b19:
%48 = iconst u8 10
ret %48
b20:
%49 = load u64 %1 56 nativus
%50 = iconst u64 12297829382473034410
%51 = cmp.eq u64 %49 %50
br %51 b22 b21
b21:
%52 = iconst u8 11
ret %52
b22:
%53 = iconst u8 200
ret %53
}
