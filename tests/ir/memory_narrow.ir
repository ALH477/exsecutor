; TEST: expect-exit=100
;
; Arrays and narrow memory access, the way lowering.md's `Index` row lowers
; `a[i]`: `%n = iconst u64 N`, `chk %i %n`, `%e = index %p %i stride`, then
; a load or store of the element type. A four-element u32 array in a `slot`
; holds 10, 20, 3000000000 (0xB2D05E00), 40; indices 2 and 3 pass `chk`
; against 4 (index 4 is trap_chk.ir). Narrow `nativus` loads zero-extend a
; uN (`movzx`, `mov r32`) and sign-extend an iN (`movsx`, `movsxd`), which
; is the canonical form straight from memory; a narrow store writes only its
; own bytes.
;
;    1  load u32 a[2] (chk, index)       = 3000000000
;    2  load i32 a[2]                    = -1294967296
;    3  load u32 at byte 12 of a[0]      = 40            (= a[3])
;    4  load u8  byte 3 of a[2]          = 178           (0xB2)
;    5  load i8  byte 3 of a[2]          = -78
;    6  load u16 bytes 2-3 of a[2]       = 45776         (0xB2D0)
;    7  load i16 bytes 2-3 of a[2]       = -19760
;    8  store u16 65535 over a[0]'s low half, load u32 a[0]  = 65535
;    9  store u8 1 at byte 3 of a[0], load u32 a[0]          = 16842751
;   10  store i32 -2 at a[1], load u32 a[1]                  = 2^32 - 2
;   11  index with a u8 index, load i32 a[1]                 = -2
;   12  load u64 at byte 8 (a[2] and a[3])                   = 174798691840
;
; Mutations (run): a narrow load that does not extend (`mov al`) -> exit 4;
; `index` without the stride multiply -> exit 1.
;
; A CHECK CHAIN: check k computes one value, compares it with `cmp.eq` at its
; own type -- a 64-bit compare, so a result left non-canonical (bits above
; N-1 wrong) never equals the canonical expected constant -- and on a
; mismatch returns k. All checks right: exit 100.

functio @initium (ptr) -> u8 {
b0:
%0 = param ptr 0
%1 = slot 16 4
%2 = iconst u64 4
%3 = iconst u64 0
%4 = index %1 %3 4
%5 = iconst u32 10
store u32 %4 0 nativus %5
%6 = iconst u64 1
%7 = index %1 %6 4
%8 = iconst u32 20
store u32 %7 0 nativus %8
%9 = iconst u64 2
%10 = index %1 %9 4
%11 = iconst u32 3000000000
store u32 %10 0 nativus %11
%12 = iconst u64 3
chk %12 %2
%13 = index %1 %12 4
%14 = iconst u32 40
store u32 %13 0 nativus %14
chk %9 %2
%15 = index %1 %9 4
%16 = load u32 %15 0 nativus
%17 = iconst u32 3000000000
%18 = cmp.eq u32 %16 %17
br %18 b2 b1
b1:
%19 = iconst u8 1
ret %19
b2:
%20 = load i32 %15 0 nativus
%21 = iconst i32 -1294967296
%22 = cmp.eq i32 %20 %21
br %22 b4 b3
b3:
%23 = iconst u8 2
ret %23
b4:
%24 = load u32 %4 12 nativus
%25 = iconst u32 40
%26 = cmp.eq u32 %24 %25
br %26 b6 b5
b5:
%27 = iconst u8 3
ret %27
b6:
%28 = load u8 %10 3 nativus
%29 = iconst u8 178
%30 = cmp.eq u8 %28 %29
br %30 b8 b7
b7:
%31 = iconst u8 4
ret %31
b8:
%32 = load i8 %10 3 nativus
%33 = iconst i8 -78
%34 = cmp.eq i8 %32 %33
br %34 b10 b9
b9:
%35 = iconst u8 5
ret %35
b10:
%36 = load u16 %10 2 nativus
%37 = iconst u16 45776
%38 = cmp.eq u16 %36 %37
br %38 b12 b11
b11:
%39 = iconst u8 6
ret %39
b12:
%40 = load i16 %10 2 nativus
%41 = iconst i16 -19760
%42 = cmp.eq i16 %40 %41
br %42 b14 b13
b13:
%43 = iconst u8 7
ret %43
b14:
%44 = iconst u16 65535
store u16 %4 0 nativus %44
%45 = load u32 %4 0 nativus
%46 = iconst u32 65535
%47 = cmp.eq u32 %45 %46
br %47 b16 b15
b15:
%48 = iconst u8 8
ret %48
b16:
%49 = iconst u8 1
store u8 %4 3 nativus %49
%50 = load u32 %4 0 nativus
%51 = iconst u32 16842751
%52 = cmp.eq u32 %50 %51
br %52 b18 b17
b17:
%53 = iconst u8 9
ret %53
b18:
%54 = iconst i32 -2
store i32 %7 0 nativus %54
%55 = load u32 %7 0 nativus
%56 = iconst u32 4294967294
%57 = cmp.eq u32 %55 %56
br %57 b20 b19
b19:
%58 = iconst u8 10
ret %58
b20:
%59 = iconst u8 1
%60 = index %1 %59 4
%61 = load i32 %60 0 nativus
%62 = iconst i32 -2
%63 = cmp.eq i32 %61 %62
br %63 b22 b21
b21:
%64 = iconst u8 11
ret %64
b22:
%65 = load u64 %4 8 nativus
%66 = iconst u64 174798691840
%67 = cmp.eq u64 %65 %66
br %67 b24 b23
b23:
%68 = iconst u8 12
ret %68
b24:
%69 = iconst u8 100
ret %69
}
