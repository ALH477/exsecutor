; TEST: expect-exit=239
;
; Constants outside a sign-extended 32-bit immediate (the wire-codec plan's
; B4). `mov qword [slot], imm` is fasmg's `x86.simm32`, so `iconst u64
; 3735928559` (0xDEADBEEF) did not assemble at all; emit.inc now writes such
; a constant as `mov rax, imm64` and a store, and keeps the one-line form for
; everything that fits, so no existing fixture's text changed.
;
;    1  0xDEAD * 65536 + 0xBEEF          = iconst u64 3735928559
;    2  zext u64 (iconst u32 3735928559) = 3735928559
;    3  trunc u8 of it                   = 239 (0xEF)
;    4  -6 * 1000000000                  = iconst i64 -6000000000
;    5  0 -% 1                           = iconst u64 18446744073709551615
;                                          (prints as -1, fits simm32)
;    6  -2^31 - 1                        = iconst i64 -2147483649  (just below)
;    7  2^31 - 1 + 1                     = iconst u64 2147483648   (just above)
;
; Without the imm64 path the emitted program does not assemble ("immediate
; value out of signed range"), which tests/run.sh reports as a failure.
;
; A CHECK CHAIN: check k computes one value, compares it with `cmp.eq` at its
; own type -- a 64-bit compare, so a result left non-canonical (bits above
; N-1 wrong) never equals the canonical expected constant -- and on a
; mismatch returns k. All checks right: exit 239.

functio @initium (ptr) -> u8 {
b0:
%0 = param ptr 0
%1 = iconst u64 57005
%2 = mul u64 %1 65536
%3 = add u64 %2 48879
%4 = iconst u64 3735928559
%5 = cmp.eq u64 %3 %4
br %5 b2 b1
b1:
%6 = iconst u8 1
ret %6
b2:
%7 = iconst u32 3735928559
%8 = zext u64 %7
%9 = iconst u64 3735928559
%10 = cmp.eq u64 %8 %9
br %10 b4 b3
b3:
%11 = iconst u8 2
ret %11
b4:
%12 = trunc u8 %7
%13 = iconst u8 239
%14 = cmp.eq u8 %12 %13
br %14 b6 b5
b5:
%15 = iconst u8 3
ret %15
b6:
%16 = iconst i64 -6
%17 = iconst i64 1000000000
%18 = mul i64 %16 %17
%19 = iconst i64 -6000000000
%20 = cmp.eq i64 %18 %19
br %20 b8 b7
b7:
%21 = iconst u8 4
ret %21
b8:
%22 = iconst u64 0
%23 = iconst u64 1
%24 = subw u64 %22 %23
%25 = iconst u64 18446744073709551615
%26 = cmp.eq u64 %24 %25
br %26 b10 b9
b9:
%27 = iconst u8 5
ret %27
b10:
%28 = iconst i64 -2147483648
%29 = sub i64 %28 1
%30 = iconst i64 -2147483649
%31 = cmp.eq i64 %29 %30
br %31 b12 b11
b11:
%32 = iconst u8 6
ret %32
b12:
%33 = iconst u64 2147483647
%34 = add u64 %33 1
%35 = iconst u64 2147483648
%36 = cmp.eq u64 %34 %35
br %36 b14 b13
b13:
%37 = iconst u8 7
ret %37
b14:
%38 = iconst u8 239
ret %38
}
