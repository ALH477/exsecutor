; TEST: expect-exit=100
;
; `zext`/`sext`/`trunc` (ssa-ir.md 2.3). T is the destination, the source is
; the operand's own type. The emitter copies, extends from the SOURCE width
; where the source's canonical form is the other extension (a `zext` of an
; iN, a `sext` of a uN), then normalises to T -- which is the whole of a
; `trunc`. lower/expr.inc's `__lwr_cast` emits `trunc` for an equal-width
; sign change, so checks 5 and 6 are what `sicut` between u8 and i8 is.
;
;    1  zext u32 (u8 200)                = 200
;    2  trunc u8 (u32 300)               = 44
;    3  trunc u8 (zext u32 (u8 200))     = 200   round trip
;    4  sext i32 (i8 -56)                = -56
;    5  trunc i8 (u8 200)                = -56
;    6  trunc u8 (i8 -56)                = 200
;    7  zext u16 (i8 -56)                = 200   zero-extend the 8 bits
;    8  sext u16 (i8 -56)                = 65480 then normalise to u16
;    9  sext i64 (u8 200)                = -56   sign-extend the 8 bits
;   10  trunc u4 (u8 171)                = 11
;   11  zext u64 (cmp.lt u8 1 2)         = 1     a u1 source
;   12  trunc i32 (sext i64 (i32 -1))    = -1
;
; Mutations (run): `trunc` without its normalisation -> exit 2; `zext`
; without the source-width step -> exit 7.
;
; A CHECK CHAIN: check k computes one value, compares it with `cmp.eq` at its
; own type -- a 64-bit compare, so a result left non-canonical (bits above
; N-1 wrong) never equals the canonical expected constant -- and on a
; mismatch returns k. All checks right: exit 100.

functio @initium (ptr) -> u8 {
b0:
%0 = param ptr 0
%1 = iconst u8 200
%2 = zext u32 %1
%3 = iconst u32 200
%4 = cmp.eq u32 %2 %3
br %4 b2 b1
b1:
%5 = iconst u8 1
ret %5
b2:
%6 = iconst u32 300
%7 = trunc u8 %6
%8 = iconst u8 44
%9 = cmp.eq u8 %7 %8
br %9 b4 b3
b3:
%10 = iconst u8 2
ret %10
b4:
%11 = iconst u8 200
%12 = zext u32 %11
%13 = trunc u8 %12
%14 = iconst u8 200
%15 = cmp.eq u8 %13 %14
br %15 b6 b5
b5:
%16 = iconst u8 3
ret %16
b6:
%17 = iconst i8 -56
%18 = sext i32 %17
%19 = iconst i32 -56
%20 = cmp.eq i32 %18 %19
br %20 b8 b7
b7:
%21 = iconst u8 4
ret %21
b8:
%22 = iconst u8 200
%23 = trunc i8 %22
%24 = iconst i8 -56
%25 = cmp.eq i8 %23 %24
br %25 b10 b9
b9:
%26 = iconst u8 5
ret %26
b10:
%27 = iconst i8 -56
%28 = trunc u8 %27
%29 = iconst u8 200
%30 = cmp.eq u8 %28 %29
br %30 b12 b11
b11:
%31 = iconst u8 6
ret %31
b12:
%32 = iconst i8 -56
%33 = zext u16 %32
%34 = iconst u16 200
%35 = cmp.eq u16 %33 %34
br %35 b14 b13
b13:
%36 = iconst u8 7
ret %36
b14:
%37 = iconst i8 -56
%38 = sext u16 %37
%39 = iconst u16 65480
%40 = cmp.eq u16 %38 %39
br %40 b16 b15
b15:
%41 = iconst u8 8
ret %41
b16:
%42 = iconst u8 200
%43 = sext i64 %42
%44 = iconst i64 -56
%45 = cmp.eq i64 %43 %44
br %45 b18 b17
b17:
%46 = iconst u8 9
ret %46
b18:
%47 = iconst u8 171
%48 = trunc u4 %47
%49 = iconst u4 11
%50 = cmp.eq u4 %48 %49
br %50 b20 b19
b19:
%51 = iconst u8 10
ret %51
b20:
%52 = iconst u8 1
%53 = iconst u8 2
%54 = cmp.lt u8 %52 %53
%55 = zext u64 %54
%56 = iconst u64 1
%57 = cmp.eq u64 %55 %56
br %57 b22 b21
b21:
%58 = iconst u8 11
ret %58
b22:
%59 = iconst i32 -1
%60 = sext i64 %59
%61 = trunc i32 %60
%62 = iconst i32 -1
%63 = cmp.eq i32 %61 %62
br %63 b24 b23
b23:
%64 = iconst u8 12
ret %64
b24:
%65 = iconst u8 100
ret %65
}
