; TEST: expect-exit=7
;
; The other arm of tier1_combo_lt.ir's `@combo` (read that file's header).
; combo(5, 2): add 5 2 = 7, 5 lt 2 is false -> b2, returns 7 unchanged.
; Distinct from the lt arm's 8, so a `br` that ignored its condition, or took
; the arms in the wrong order, fails one of the two.

functio @combo (u64 u64) -> u64 {
b0:
%0 = param u64 0
%1 = param u64 1
%2 = add u64 %0 %1
%3 = cmp.lt u64 %0 %1
br %3 b1 b2
b1:
%4 = addw u64 %2 1
ret %4
b2:
ret %2
}

functio @initium (ptr) -> u64 {
b0:
%0 = param ptr 0
%1 = iconst u64 5
%2 = iconst u64 2
%3 = call u64 @combo %1 %2
ret %3
}
