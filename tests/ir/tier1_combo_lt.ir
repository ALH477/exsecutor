; TEST: expect-exit=8
;
; tests/unit/bfa_emit_tier1.asm's `@combo`, byte for byte, RUN. That fixture
; proves the emitted TEXT; its header says the running half "was done by
; hand, outside this harness". This is that half, inside it.
;
; combo(3, 4): add 3 4 = 7 (no carry), 3 lt 4 is true -> b1, addw 7 1 = 8.
; tier1_combo_ge.ir takes the other arm; trap_add_carry.ir takes the trap.
;
; `@initium` is declared `-> u64`, not the `-> u8` a lowering emits, because
; nothing narrows a u64 to a u8 in the Tier-1 emitter yet (`trunc` arrives
; with narrow integers, milestone M3 of the wire-codec plan). The prelude
; reads `al` after `call bfausr_initium` either way (prelude.asm,
; `exsrt_start`), so the exit status is the low byte of the result. When
; `trunc` exists this should become `-> u8` with a `trunc u8`.

functio @combo (u64 u64) -> u64 {
b0:
%0 = param u64 0
%1 = param u64 1
%2 = add u64 %0 %1
%3 = cmp.lt u64 %0 %1
br %3 b1 b2
b1:
%4 = addw u64 %2 1
ret %4
b2:
ret %2
}

functio @initium (ptr) -> u64 {
b0:
%0 = param ptr 0
%1 = iconst u64 3
%2 = iconst u64 4
%3 = call u64 @combo %1 %2
ret %3
}
