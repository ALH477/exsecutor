br %47 b22 b21
b21:
%48 = iconst u8 11
ret %48
b22:
%49 = iconst u8 0
store u8 %1 2 nativus %49
%50 = iconst u4 12
storebits u4 %1 2 0 %50
%51 = load u8 %1 2 nativus
%52 = iconst u8 192
%53 = cmp.eq u8 %51 %52
br %53 b24 b23
b23:
%54 = iconst u8 12
ret %54
b24:
%55 = iconst u4 3
storebits u4 %1 2 4 %55
%56 = load u8 %1 2 nativus
%57 = iconst u8 195
%58 = cmp.eq u8 %56 %57
br %58 b26 b25
b25:
%59 = iconst u8 13
ret %59
b26:
%60 = iconst u4 1
storebits u4 %1 2 0 %60
%61 = load u8 %1 2 nativus
%62 = iconst u8 19
%63 = cmp.eq u8 %61 %62
br %63 b28 b27
b27:
%64 = iconst u8 14
ret %64
b28:
%65 = iconst u8 255
store u8 %1 3 nativus %65
%66 = iconst u1 0
storebits u1 %1 3 0 %66
%67 = iconst u1 0
storebits u1 %1 3 7 %67
%68 = load u8 %1 3 nativus
%69 = iconst u8 126
%70 = cmp.eq u8 %68 %69
br %70 b30 b29
b29:
%71 = iconst u8 15
ret %71
b30:
%72 = iconst u8 0
store u8 %1 4 nativus %72
%73 = iconst u1 1
storebits u1 %1 4 3 %73
%74 = load u8 %1 4 nativus
%75 = iconst u8 16
%76 = cmp.eq u8 %74 %75
br %76 b32 b31
b31:
%77 = iconst u8 16
ret %77
b32:
%78 = iconst u8 0
store u8 %1 5 nativus %78
%79 = iconst u3 5
storebits u3 %1 5 2 %79
%80 = load u8 %1 5 nativus
%81 = iconst u8 40
%82 = cmp.eq u8 %80 %81
br %82 b34 b33
b33:
%83 = iconst u8 17
ret %83
b34:
%84 = iconst u8 255
store u8 %1 6 nativus %84
%85 = iconst u3 0
storebits u3 %1 6 5 %85
%86 = load u8 %1 6 nativus
%87 = iconst u8 248
%88 = cmp.eq u8 %86 %87
br %88 b36 b35
b35:
%89 = iconst u8 18
ret %89
b36:
%90 = iconst u8 90
storebits u8 %1 6 0 %90
%91 = load u8 %1 6 nativus
%92 = iconst u8 90
%93 = cmp.eq u8 %91 %92
br %93 b38 b37
b37:
%94 = iconst u8 19
ret %94
b38:
%95 = load u8 %1 0 nativus
%96 = iconst u8 165
%97 = cmp.eq u8 %95 %96
br %97 b40 b39
b39:
%98 = iconst u8 20
ret %98
b40:
%99 = load u8 %1 1 nativus
%100 = iconst u8 19
%101 = cmp.eq u8 %99 %100
br %101 b42 b41
b41:
%102 = iconst u8 21
ret %102
b42:
%103 = load u8 %1 5 nativus
%104 = iconst u8 40
%105 = cmp.eq u8 %103 %104
br %105 b44 b43
b43:
%106 = iconst u8 22
ret %106
b44:
%107 = load u8 %1 7 nativus
%108 = iconst u8 119
%109 = cmp.eq u8 %107 %108
br %109 b46 b45
b45:
