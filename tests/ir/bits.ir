; TEST: expect-exit=150
;
; `loadbits`/`storebits` (ssa-ir.md 2.7; wire-codec.md milestone M4) at both
; nibbles, a 1-bit field at the top, the bottom and the middle of a byte, a
; 3-bit field at three offsets, and the whole byte as a u8 field. The bit
; operand counts from the MOST significant bit of the byte: spec 5.2 rule 1
; (sub-byte fields pack MSB-first in declaration order) and
; checker/rows/layout.inc (a field's bit offset is the bits declared before
; it in its byte). So `loadbits u4 %p 1 0` is DeModFrame's `versio`, bits
; 7..4 of byte 1, and `loadbits u4 %p 1 4` its `genus`, bits 3..0 -- checks
; 10 and 11 read them from 0x13.
;
; `storebits` is a read-modify-write of one byte: the field's old bits are
; cleared (check 14 overwrites a nibble that already held 1100), the rest of
; the byte kept (checks 13-15), and the neighbouring bytes untouched (20-23).
;
; Mutations (run): the bit operand read LSB-first (S = bit, not 8 - bit - w)
; -> exit 1; the store's clear-the-field mask dropped (old bits kept) ->
; exit 14.
;
; A CHECK CHAIN: check k compares one value and on a mismatch returns k.
; All 23 right: exit 150.
;
;    1  loadbits u4 %s 0 0         = 10     high nibble: bit 0 is the MSB
;    2  loadbits u4 %s 0 4         = 5      low nibble
;    3  loadbits u1 %s 0 0         = 1      bit 7 of the byte
;    4  loadbits u1 %s 0 1         = 0      bit 6
;    5  loadbits u1 %s 0 7         = 1      bit 0, the LSB
;    6  loadbits u3 %s 0 0         = 5      101
;    7  loadbits u3 %s 0 3         = 1      001
;    8  loadbits u3 %s 0 5         = 5      101
;    9  loadbits u8 %s 0 0         = 165    the whole byte
;   10  loadbits u4 %s 1 0         = 1      DeModFrame versio
;   11  loadbits u4 %s 1 4         = 3      DeModFrame genus
;   12  load u8 byte 2             = 0xc0   storebits u4 12 at bit 0 of 0x00
;   13  load u8 byte 2             = 0xc3   then u4 3 at bit 4: the high nibble kept
;   14  load u8 byte 2             = 0x13   then u4 1 at bit 0: old bits cleared, low nibble kept
;   15  load u8 byte 3             = 0x7e   u1 0 at bits 0 and 7 of 0xff
;   16  load u8 byte 4             = 0x10   u1 1 at bit 3 of 0x00
;   17  load u8 byte 5             = 0x28   u3 101 at bit 2 of 0x00: 0010 1000
;   18  load u8 byte 6             = 0xf8   u3 0 at bit 5 of 0xff
;   19  load u8 byte 6             = 0x5a   u8 at bit 0: the whole byte
;   20  load u8 byte 0             = 0xa5   byte 0 untouched
;   21  load u8 byte 1             = 0x13   byte 1 untouched
;   22  load u8 byte 5             = 0x28   byte 5 untouched by byte 6's stores
;   23  load u8 byte 7             = 0x77   byte 7 untouched

functio @initium (ptr) -> u8 {
b0:
%0 = param ptr 0
%1 = slot 8 8
%2 = iconst u8 165
store u8 %1 0 nativus %2
%3 = iconst u8 119
store u8 %1 7 nativus %3
%4 = iconst u8 19
store u8 %1 1 nativus %4
%5 = loadbits u4 %1 0 0
%6 = iconst u4 10
%7 = cmp.eq u4 %5 %6
br %7 b2 b1
b1:
%8 = iconst u8 1
ret %8
b2:
%9 = loadbits u4 %1 0 4
%10 = iconst u4 5
%11 = cmp.eq u4 %9 %10
br %11 b4 b3
b3:
%12 = iconst u8 2
ret %12
b4:
%13 = loadbits u1 %1 0 0
%14 = iconst u1 1
%15 = cmp.eq u1 %13 %14
br %15 b6 b5
b5:
%16 = iconst u8 3
ret %16
b6:
%17 = loadbits u1 %1 0 1
%18 = iconst u1 0
%19 = cmp.eq u1 %17 %18
br %19 b8 b7
b7:
%20 = iconst u8 4
ret %20
b8:
%21 = loadbits u1 %1 0 7
%22 = iconst u1 1
%23 = cmp.eq u1 %21 %22
br %23 b10 b9
b9:
%24 = iconst u8 5
ret %24
b10:
%25 = loadbits u3 %1 0 0
%26 = iconst u3 5
%27 = cmp.eq u3 %25 %26
br %27 b12 b11
b11:
%28 = iconst u8 6
ret %28
b12:
%29 = loadbits u3 %1 0 3
%30 = iconst u3 1
%31 = cmp.eq u3 %29 %30
br %31 b14 b13
b13:
%32 = iconst u8 7
ret %32
b14:
