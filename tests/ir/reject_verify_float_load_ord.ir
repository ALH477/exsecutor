; TEST: emit-exit=5
;
; `load f64 %p 0 maior`: byte order applied to a float. Verifier rule 1
; (verify.inc's `__bfa_verify_memty`): "`maior`/`minor` order an
; integer's bytes, so they need a uN/iN" -- byte order is an integer
; surface (spec 5.2), and a float in memory is bit baggage with no
; numeric reading, so the honest orders are `nativus` and refusal. The
; emitter refuses the same text by name (exit 4) for the `exsc` path
; that reaches it without the verifier; this fixture's 5 says the
; verifier got there first, as reject_verify_load_width.ir's does for
; the width arm. The nativus half runs, in float_mem.ir.
;
; Mutation (run): __bfa_verify_memty's uN/iN test for maior/minor
; dropped -> emit_ir exits 4 (the emitter's refusal), not 5.

functio @initium (ptr) -> u8 {
b0:
%0 = param ptr 0
%1 = slot 8 8
%2 = load f64 %1 0 maior
%3 = ftoi u8 %2
ret %3
}
