; TEST: expect-exit=100
;
; Compares at narrow widths need no normalisation, only the right condition
; code: a canonical u8 is zero-extended and a canonical i8 sign-extended, so
; one 64-bit `cmp` orders them correctly provided `setb`/`seta` follow a uN
; and `setl`/`setg` an iN (emit.inc's `__bfa_emit_setcc`, "signedness from
; T"). The same bits, 200, are above 100 as a u8 and below it as an i8.
;
;    1  cmp.lt u8  200 100          0
;    2  cmp.gt u8  200 100          1
;    3  cmp.lt i8  -56 100          1
;    4  cmp.gt i8  -56 100          0
;    5  cmp.ge u8  255 0            1
;    6  cmp.le i8  -128 127         1
;    7  cmp.gt u32 3000000000 1     1
;    8  cmp.lt i32 -1294967296 1    1   (3000000000's bits as an i32)
;    9  cmp.lt i8  (trunc i8 (u8 200)) 100   1
;   10  cmp.eq u16 65535 65535      1
;   11  cmp.ne u4  15 14            1
;
; Mutation (run): every compare unsigned -> exit 3.
;
; A CHECK CHAIN: check k computes one value, compares it with `cmp.eq` at its
; own type -- a 64-bit compare, so a result left non-canonical (bits above
; N-1 wrong) never equals the canonical expected constant -- and on a
; mismatch returns k. All checks right: exit 100.

functio @initium (ptr) -> u8 {
b0:
%0 = param ptr 0
%1 = iconst u8 200
%2 = iconst u8 100
%3 = cmp.lt u8 %1 %2
%4 = zext u8 %3
%5 = iconst u8 0
%6 = cmp.eq u8 %4 %5
br %6 b2 b1
b1:
%7 = iconst u8 1
ret %7
b2:
%8 = iconst u8 200
%9 = iconst u8 100
%10 = cmp.gt u8 %8 %9
%11 = zext u8 %10
%12 = iconst u8 1
%13 = cmp.eq u8 %11 %12
br %13 b4 b3
b3:
%14 = iconst u8 2
ret %14
b4:
%15 = iconst i8 -56
%16 = iconst i8 100
%17 = cmp.lt i8 %15 %16
%18 = zext u8 %17
%19 = iconst u8 1
%20 = cmp.eq u8 %18 %19
br %20 b6 b5
b5:
%21 = iconst u8 3
ret %21
b6:
%22 = iconst i8 -56
%23 = iconst i8 100
%24 = cmp.gt i8 %22 %23
%25 = zext u8 %24
%26 = iconst u8 0
%27 = cmp.eq u8 %25 %26
br %27 b8 b7
b7:
%28 = iconst u8 4
ret %28
b8:
%29 = iconst u8 255
%30 = iconst u8 0
%31 = cmp.ge u8 %29 %30
%32 = zext u8 %31
%33 = iconst u8 1
%34 = cmp.eq u8 %32 %33
br %34 b10 b9
b9:
%35 = iconst u8 5
ret %35
b10:
%36 = iconst i8 -128
%37 = iconst i8 127
%38 = cmp.le i8 %36 %37
%39 = zext u8 %38
%40 = iconst u8 1
%41 = cmp.eq u8 %39 %40
br %41 b12 b11
b11:
%42 = iconst u8 6
ret %42
b12:
%43 = iconst u32 3000000000
%44 = iconst u32 1
%45 = cmp.gt u32 %43 %44
%46 = zext u8 %45
%47 = iconst u8 1
%48 = cmp.eq u8 %46 %47
br %48 b14 b13
b13:
%49 = iconst u8 7
ret %49
b14:
%50 = iconst i32 -1294967296
%51 = iconst i32 1
%52 = cmp.lt i32 %50 %51
%53 = zext u8 %52
%54 = iconst u8 1
%55 = cmp.eq u8 %53 %54
br %55 b16 b15
b15:
%56 = iconst u8 8
ret %56
b16:
%57 = iconst u8 200
%58 = trunc i8 %57
%59 = iconst i8 100
%60 = cmp.lt i8 %58 %59
%61 = zext u8 %60
%62 = iconst u8 1
%63 = cmp.eq u8 %61 %62
br %63 b18 b17
b17:
%64 = iconst u8 9
ret %64
b18:
%65 = iconst u16 65535
%66 = iconst u16 65535
%67 = cmp.eq u16 %65 %66
%68 = zext u8 %67
%69 = iconst u8 1
%70 = cmp.eq u8 %68 %69
br %70 b20 b19
b19:
%71 = iconst u8 10
ret %71
b20:
%72 = iconst u4 15
%73 = iconst u4 14
%74 = cmp.ne u4 %72 %73
%75 = zext u8 %74
%76 = iconst u8 1
%77 = cmp.eq u8 %75 %76
br %77 b22 b21
b21:
%78 = iconst u8 11
ret %78
b22:
%79 = iconst u8 100
ret %79
}
