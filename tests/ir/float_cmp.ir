; TEST: expect-exit=100
;
; The six ORDERED fcmp forms (ssa-ir.md 2.3): FALSE whenever either operand
; is a NaN. The emitter's `ucomisd`/`ucomiss` latch ZF/CF/PF, unordered
; sets all three, and `setnp` + `and` forces the 0 -- so this file holds
; the ORDERED contract in the rows a branchy `jp` design would cover, with
; check 13 the load-bearing one: an UNordered `ne` would answer 1 on a NaN
; operand and fail it. No IR can write an unordered form (the parser's
; vocabulary is the six), which is what the emitted `and` enforces.
;
; A check whose value SHOULD be 1 branches on it directly; a check whose
; value should be 0 goes through `zext u64` + a 64-bit compare against 0
; (conv_roundtrip.ir's idiom), so a non-canonical u1 also fails.
;
; Constants: f64 2.5 = 4612811918334230528, f64 1.5 = 4609434218613702656,
; f64 NaN = 9221120237041090560 (a quiet NaN), f32 2.5f = 1075838976,
; f32 1.0f = 1065353216, f32 NaNf = 2143289344.
;
;    1  eq  2.5 == 2.5     -> 1
;    2  eq  1.5 == 2.5     -> 0
;    3  ne  1.5 != 2.5     -> 1
;    4  ne  2.5 != 2.5     -> 0
;    5  lt  1.5 <  2.5     -> 1
;    6  lt  2.5 <  1.5     -> 0   operand order: `ucomisd a, b`, setb
;    7  lt  2.5 <  2.5     -> 0
;    8  le  2.5 <= 2.5     -> 1
;    9  le  2.5 <= 1.5     -> 0
;   10  gt  2.5 >  1.5     -> 1   seta, not setb of the swapped operands
;   11  ge  2.5 >= 2.5     -> 1
;   12  eq  NaN == 2.5     -> 0   unordered eq is 0 even unordered
;   13  ne  NaN != 2.5     -> 0   THE ordered-ne row
;   14  lt  NaN <  2.5     -> 0
;   15  le  NaN <= 2.5     -> 0
;   16  gt  NaN >  2.5     -> 0
;   17  ge  NaN >= 2.5     -> 0
;   18  lt  2.5 <  NaN     -> 0   the NaN on the RIGHT, both directions
;   19  f32 eq 2.5f == 2.5f -> 1  the ucomiss arm
;   20  f32 ne NaNf != 1.0f -> 0  ordered, in f32
;
; Mutation (run): drop the `and al, cl` -> 12 and 13 both answer 1 (exit
; 12 or 13); swap gt/ge to the swapped-operand setb/setbe -> 10 and 11
; answer 0 (exit 10, 11).

functio @initium (ptr) -> u8 {
b0:
%0 = param ptr 0
%1 = fconst f64 4612811918334230528
%2 = fconst f64 4612811918334230528
%3 = fcmp.eq f64 %1 %2
br %3 b2 b1
b1:
%4 = iconst u8 1
ret %4
b2:
%5 = fconst f64 4609434218613702656
%6 = fconst f64 4612811918334230528
%7 = fcmp.eq f64 %5 %6
%8 = zext u64 %7
%9 = iconst u64 0
%10 = cmp.eq u64 %8 %9
br %10 b4 b3
b3:
%11 = iconst u8 2
ret %11
b4:
