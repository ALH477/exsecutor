// needs the type checker (Stage 2). compiler/x86_64/ast/ and cst/ are both
// still empty; `exsc aedifica`, run directly against this file, exits 0
// and reports nothing -- confirmed, not assumed.

structura Nodus { valor: mensura }

externus("C", abi: sysv_amd64) {
    functio consume_nodum(n: refero<Nodus>) -> mensura
}

