functio @summa (u64) -> u64 numeri ad_parem vetita explicita conservata {
b0:
%0 = param u64 0
%1 = iconst u64 0
%2 = redinit u64 add ordinata 0
jmp b1
b1:
%3 = phi u64 b0 %1 b4 %7
%4 = cmp.lt u64 %3 %0
br %4 b2 b3
b2:
contrib %2 %3
jmp b4
b3:
%5 = redfin u64 %2
ret %5
b4:
%6 = iconst u64 1
%7 = addw u64 %3 %6
jmp b1
}
