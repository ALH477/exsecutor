// file reproduces line 3, col 5, and a fix insert of `;` at byte 76 relative
// to that first byte -- exactly as reported.

publica functio incrementa(a: u64, b: u64) -> u64 {
    mutabilis t: u64 = 0
    firma u: u64 = 1;
    redde u;
