// ---------------------------------------------------------------------------
// The engine: read one request on stdin, then write frames on stdout until
// the request is satisfied. This is where authority enters, once, as the
// `Mundus` of `initium` (spec §4.7); the somnia are pure arithmetic over
// storage this function owns. The program's whole capability is `ambitus`
// -- the standard streams -- so its syscall surface is read(0), write(1)
// and exit_group, auditable under `--potestates Mundus,ambitus`.
//
// THE REQUEST, 17 bytes and then end of input (docs/design/somnium.md §3):
//
//   0..4    "SOM1"                 magic and version
//   4       somnium                0 plasma, 1 ignis, 2 vita, 3 pluvia,
//                                  4 stellae, 5 cuniculus, 6 abyssus,
//                                  7 titulus, 8 signum, 9 fulmen, 10 cruor, 11 pyramis
//   5..9    praetermitte, u32 LE   frames advanced but not written
//   9..13   tabulae, u32 LE        frames written
//   13..17  semen, u32 LE          the only entropy; 0 means 0x9E3779B9
//
// Somnium 8 alone carries more: the 3D engine's 44,801-byte EXSG model
// (tests/data/signaculum_mesh.bin) follows the 17 bytes, and its magic and
// counts are checked before a frame is rendered.
//
// A short request, a long one, a wrong magic or an unknown somnium writes
// nothing and exits 1. Exit 0 is every frame written; exit 2 is a frame
// the consumer would not take -- reachable only when SIGPIPE is ignored,
// since by default a closed pipe kills the process at the write (the
// runtime's SIGPIPE handling is `[OPEN]`, docs/design/runtime.md).
//
// A screensaver runs until someone moves the mouse, and a `per` needs a
// bound, so "forever" is tabulae = 0xFFFFFFFF: at 20 frames a second,
// about 6.8 years. The host stops the engine by closing the pipe.
// ---------------------------------------------------------------------------

functio verbum(r: acies<u8, 17>, p: mensura) -> u32 {
    redde r[p] sicut u32 + (r[p + 1] sicut u32 sursum 8) + (r[p + 2] sicut u32 sursum 16)
        + (r[p + 3] sicut u32 sursum 24);
}

// One frame, in ONE write(2) -- spec §4.6's `scribe_octetos`.
//
// This was a `per i in 0..48000` of `scribe_octeto`, and somnium.exsc's
// header still explains why the frame is 160x100 rather than 320x200: at one
// write(2) per byte, a bigger frame was unaffordable. docs/design/somnium.md
// section 10 measured what that cost -- 16.6 to 17.4 ms a frame on the
// reference build for SEVEN OF THE NINE somnia, whatever they computed,
// because none of them was what the time was going on. The C build, whose
// host buffers the frame, did the same work in 0.14 to 0.23 ms.
//
// The bulk row closes that. Nothing else in this file changes, and no
// golden moves: the bytes written are the same bytes in the same order, and
// tests/programs/somnium_*/ is what proves it rather than this comment.
//
// The count is still checked against 48,000 by the caller, so a short write
// -- the only failure signal a count-returning call has -- still exits 2.
functio scribe_tabulam(s: Scriptor, fb: acies<u8, 48000>) -> mensura {
    redde s.scribe_octetos(fb, 48000);
}

functio machina(l: Lector, s: Scriptor) -> u8 {
    // ---- the request: 17 bytes, the model for somnium 8, then the end ------
    // One read(2), not seventeen. A SHORT COUNT IS THE REFUSAL: `lege_octetos`
    // reads fully (spec §4.6), so fewer than 17 bytes means the input ended --
    // which is exactly what the per-byte loop this replaces was testing when
    // it compared each `lege_octeto` against 256. `somnium_brevis` (16 bytes)
    // is the fixture that holds it.
    mutabilis r: acies<u8, 17> = [0; 17];
    si l.lege_octetos(r, 17) ne 17 {
        redde 1;
    }
    si r[0] ne 0x53 { redde 1; }    // S
    si r[1] ne 0x4F { redde 1; }    // O
    si r[2] ne 0x4D { redde 1; }    // M
    si r[3] ne 0x31 { redde 1; }    // 1
    firma somnium: u8 = r[4];
    si somnium gt 11 {
        redde 1;
    }
    mutabilis exsg: acies<u8, 44801> = [0; 44801];
    si somnium eq 8 {
        // The 44,801-byte model in ONE read(2) rather than 44,801 of them.
        // This is the call that made the read side worth changing: before it,
        // a somnium 8 request cost 44,819 read(2) (strace -c, measured) while
        // the whole frame path had already been reduced to one write(2).
        // Short count = a truncated model = refused, and
        // `somnium_signum_brevis` (one byte short) is the fixture for it.
        si l.lege_octetos(exsg, 44801) ne 44801 {
            redde 1;
        }
        // "EXSG", 1493 vertices, 2981 faces -- what signaculum_pingue
        // would refuse with 1 or 2 -- refused here, before any frame.
        si exsg[0] ne 69 { redde 1; }
        si exsg[1] ne 88 { redde 1; }
        si exsg[2] ne 83 { redde 1; }
        si exsg[3] ne 71 { redde 1; }
        si exsg[4] ne 0xD5 { redde 1; }
        si exsg[5] ne 0x05 { redde 1; }
        si exsg[6] ne 0 { redde 1; }
        si exsg[7] ne 0 { redde 1; }
        si exsg[8] ne 0xA5 { redde 1; }
        si exsg[9] ne 0x0B { redde 1; }
        si exsg[10] ne 0 { redde 1; }
        si exsg[11] ne 0 { redde 1; }
    }
    firma finis: u16 = l.lege_octeto();
    si finis ne 256 {
        redde 1;
    }
    firma praetermitte: mensura = verbum(r, 5) sicut mensura;
    firma tabulae: mensura = verbum(r, 9) sicut mensura;
    mutabilis semen: u32 = verbum(r, 13);
    si semen eq 0 {
        semen = 0x9E3779B9;
    }

    // ---- the storage every somnium advances ------------------------------
    // All zero-filled by the repeat form (spec §8.6). About 3 MB, nearly
    // all of it the 3D engine's 512 x 512 frame and f64 z-buffer: under the
    // 8 MiB default stack, as signaculum.exsc's pump is.
    mutabilis fb: acies<u8, 48000> = [0; 48000];
    mutabilis calor: acies<u8, 16320> = [0; 16320];
    mutabilis vita_a: acies<u8, 16000> = [0; 16000];
    mutabilis vita_b: acies<u8, 16000> = [0; 16000];
    mutabilis pluvia = Pluvia {
        caput: [0; 40],
        velocitas: [0; 40],
        lux: [0; 800],
        signum: [0; 800]
    };
    mutabilis stellae = Stellae {
        x: [0; 256],
        y: [0; 256],
        z: [0; 256]
    };
    mutabilis magnum: acies<u8, 786432> = [0; 786432];
    mutabilis zb: acies<f64, 262144> = [0.0; 262144];
    mutabilis x: u32 = semen;
    mutabilis phasis: mensura = 0;
    mutabilis nihil: u32 = 0;
    mutabilis status: u8 = 0;

    per f in 0..(praetermitte + tabulae) {
        si somnium eq 0 {
            si f ge praetermitte {
                x = plasma_pinge(fb, f, semen);
            }
        }
        si somnium eq 1 {
            x = ignis_pinge(fb, calor, x);
        }
        si somnium eq 2 {
            x = vita_pinge(fb, vita_a, vita_b, x, f);
        }
        si somnium eq 3 {
            x = pluvia_pinge(fb, pluvia, x, f);
        }
        si somnium eq 4 {
            x = stellae_pinge(fb, stellae, x, f);
        }
        si somnium eq 5 {
            // vita's two boards are the tunnel's two tables.
            nihil = cuniculus_pinge(fb, vita_a, vita_b, f);
        }
        si somnium eq 6 {
            si f ge praetermitte {
                nihil = abyssus_pinge(fb, phasis);
            }
            phasis = phasis + 1;
            si phasis ge 720 {
                phasis = 0;
            }
        }
        si somnium eq 7 {
            si f ge praetermitte {
                nihil = titulus_pinge(fb, phasis, semen);
            }
            phasis = phasis + 1;
            si phasis ge 400 {
                phasis = 0;
            }
        }
        si somnium eq 8 {
            x = stellae_pinge(fb, stellae, x, f);
            si f ge praetermitte {
                nihil = signum_rota(exsg, phasis);
                status = signaculum_pingue(exsg, magnum, zb);
                nihil = signum_compone(fb, magnum, phasis);
            }
            phasis = octo(phasis + 1);
        }
        si somnium eq 9 {
            si f ge praetermitte {
                x = fulmen_pinge(fb, f, semen);
            }
        }
        si somnium eq 10 {
            si f ge praetermitte {
                x = cruor_pinge(fb, f, semen);
            }
        }
        si somnium eq 11 {
            si f ge praetermitte {
                x = pyramis_pinge(fb, f, semen);
            }
        }
        si f ge praetermitte {
            si scribe_tabulam(s, fb) ne 48000 {
                redde 2;
            }
        }
    }
    redde 0;
}

publica functio initium(m: Mundus) -> u8 {
    firma a = m.ambitus();
    sub ambitus = a;
    firma l = Lector.ab_introitu(a);
    firma s = Scriptor.ad_exitum(a);
    redde machina(l, s);
}
