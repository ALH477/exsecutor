// ---------------------------------------------------------------------------
// The engine: read one request on stdin, then write frames on stdout until
// the request is satisfied. This is where authority enters, once, as the
// `Mundus` of `initium` (spec §4.7); the somnia are pure arithmetic over
// storage this function owns. The program's whole capability is `ambitus`
// -- the standard streams -- so its syscall surface is read(0), write(1)
// and exit_group, auditable under `--potestates Mundus,ambitus`.
//
// THE REQUEST, 17 bytes and then end of input (docs/design/somnium.md §3):
//
//   0..4    "SOM1"                 magic and version
//   4       somnium                0 plasma, 1 ignis, 2 vita
//   5..9    praetermitte, u32 LE   frames advanced but not written
//   9..13   tabulae, u32 LE        frames written
//   13..17  semen, u32 LE          the only entropy; 0 means 0x9E3779B9
//
// A short request, a long one, a wrong magic or an unknown somnium writes
// nothing and exits 1. Exit 0 is every frame written; exit 2 is a frame
// the consumer would not take -- reachable only when SIGPIPE is ignored,
// since by default a closed pipe kills the process at the write (the
// runtime's SIGPIPE handling is `[OPEN]`, docs/design/runtime.md).
//
// A screensaver runs until someone moves the mouse, and a `per` needs a
// bound, so "forever" is tabulae = 0xFFFFFFFF: at 20 frames a second,
// about 6.8 years. The host stops the engine by closing the pipe.
// ---------------------------------------------------------------------------

functio verbum(r: acies<u8, 17>, p: mensura) -> u32 {
    redde r[p] sicut u32 + (r[p + 1] sicut u32 sursum 8) + (r[p + 2] sicut u32 sursum 16)
        + (r[p + 3] sicut u32 sursum 24);
}

// One frame, byte by byte: 48,000 write(2) calls (somnium.exsc's header).
functio scribe_tabulam(s: Scriptor, fb: acies<u8, 48000>) -> mensura {
    mutabilis n: mensura = 0;
    per i in 0..48000 {
        n = n + s.scribe_octeto(fb[i]);
    }
    redde n;
}

functio machina(l: Lector, s: Scriptor) -> u8 {
    // ---- the request: exactly 17 bytes, then end of input ----------------
    mutabilis r: acies<u8, 17> = [0; 17];
    per i in 0..17 {
        firma o: u16 = l.lege_octeto();
        si o ge 256 {
            redde 1;
        }
        r[i] = o sicut u8;
    }
    firma finis: u16 = l.lege_octeto();
    si finis ne 256 {
        redde 1;
    }
    si r[0] ne 0x53 { redde 1; }    // S
    si r[1] ne 0x4F { redde 1; }    // O
    si r[2] ne 0x4D { redde 1; }    // M
    si r[3] ne 0x31 { redde 1; }    // 1
    firma somnium: u8 = r[4];
    si somnium gt 2 {
        redde 1;
    }
    firma praetermitte: mensura = verbum(r, 5) sicut mensura;
    firma tabulae: mensura = verbum(r, 9) sicut mensura;
    mutabilis semen: u32 = verbum(r, 13);
    si semen eq 0 {
        semen = 0x9E3779B9;
    }

    // ---- the storage every somnium advances ------------------------------
    // ~96 KB of stack, all zero-filled by the repeat form (spec §8.6).
    mutabilis fb: acies<u8, 48000> = [0; 48000];
    mutabilis calor: acies<u8, 16320> = [0; 16320];
    mutabilis vita_a: acies<u8, 16000> = [0; 16000];
    mutabilis vita_b: acies<u8, 16000> = [0; 16000];
    mutabilis x: u32 = semen;

    per f in 0..(praetermitte + tabulae) {
        si somnium eq 0 {
            si f ge praetermitte {
                x = plasma_pinge(fb, f, semen);
            }
        }
        si somnium eq 1 {
            x = ignis_pinge(fb, calor, x);
        }
        si somnium eq 2 {
            x = vita_pinge(fb, vita_a, vita_b, x, f);
        }
        si f ge praetermitte {
            si scribe_tabulam(s, fb) ne 48000 {
                redde 2;
            }
        }
    }
    redde 0;
}

publica functio initium(m: Mundus) -> u8 {
    firma a = m.ambitus();
    sub ambitus = a;
    firma l = Lector.ab_introitu(a);
    firma s = Scriptor.ad_exitum(a);
    redde machina(l, s);
}
