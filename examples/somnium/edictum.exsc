// ---------------------------------------------------------------------------
// Somnium 12: four lines of 5x7 type scrolling left. Own glyph table
// (" ABCDEHIKLMNOSTUVWX"), not formae() -- W/D/B/K would move titulus
// goldens. t deorsum 1 so the marquee is slow; no flash.
// ---------------------------------------------------------------------------

publica functio edictum_pinge(fb: &mutabilis acies<u8, 48000>, t: mensura, semen: u32) -> u32 {
    firma s: acies<u8, 256> = sinus();
    firma pa: mensura = octo(semen sicut mensura);
    firma tardus: mensura = t deorsum 1;
    firma f: acies<u8, 133> = [
        0, 0, 0, 0, 0, 0, 0,
        14, 17, 17, 31, 17, 17, 17,
        30, 17, 17, 30, 17, 17, 30,
        14, 17, 16, 16, 16, 17, 14,
        30, 17, 17, 17, 17, 17, 30,
        31, 16, 16, 30, 16, 16, 31,
        17, 17, 17, 31, 17, 17, 17,
        14, 4, 4, 4, 4, 4, 14,
        17, 18, 20, 24, 20, 18, 17,
        16, 16, 16, 16, 16, 16, 31,
        17, 27, 21, 21, 17, 17, 17,
        17, 25, 21, 19, 17, 17, 17,
        14, 17, 17, 17, 17, 17, 14,
        15, 16, 16, 14, 1, 1, 30,
        31, 4, 4, 4, 4, 4, 4,
        17, 17, 17, 17, 17, 17, 14,
        17, 17, 17, 17, 17, 10, 4,
        17, 17, 17, 21, 21, 21, 10,
        17, 17, 10, 4, 10, 17, 17
    ];

    per y in 0..100 {
        firma linea: mensura = y * 160;
        per x in 0..160 {
            firma k: mensura = (linea + x) * 3;
            firma caelum: mensura = (s[octo(y + (tardus deorsum 1) + pa)] sicut mensura) deorsum 5;
            (*fb)[k] = (caelum deorsum 1) sicut u8;
            (*fb)[k + 1] = 0;
            (*fb)[k + 2] = (caelum + 4) sicut u8;
        }
    }

    per linea in 0..4 {
        mutabilis cr: mensura = 200;
        mutabilis cg: mensura = 40;
        mutabilis cb: mensura = 40;
        mutabilis base_y: mensura = 16;
        mutabilis phase: mensura = 0;
        mutabilis nch: mensura = 14;
        si linea eq 1 {
            cr = 180;
            cg = 80;
            cb = 40;
            base_y = 38;
            phase = 48;
            nch = 10;
        }
        si linea eq 2 {
            cr = 40;
            cg = 220;
            cb = 80;
            base_y = 60;
            phase = 96;
            nch = 12;
        }
        si linea eq 3 {
            cr = 120;
            cg = 140;
            cb = 180;
            base_y = 82;
            phase = 144;
            nch = 9;
        }
        firma ox: mensura = octo(256 - octo(tardus + phase + pa));
        per n in 0..14 {
            si n lt nch {
            mutabilis g: mensura = 0;
            si linea eq 0 {
                firma v0: acies<u8, 14> = [7, 0, 6, 1, 14, 5, 0, 17, 7, 11, 4, 12, 17, 13];
                g = v0[n] sicut mensura;
            }
            si linea eq 1 {
                firma v1: acies<u8, 10> = [7, 0, 6, 1, 14, 5, 0, 10, 1, 3];
                g = v1[n] sicut mensura;
            }
            si linea eq 2 {
                firma v2: acies<u8, 12> = [7, 0, 9, 12, 16, 5, 0, 9, 7, 11, 15, 18];
                g = v2[n] sicut mensura;
            }
            si linea eq 3 {
                firma v3: acies<u8, 9> = [2, 13, 4, 0, 7, 13, 0, 12, 8];
                g = v3[n] sicut mensura;
            }
            per rr in 0..7 {
                per cc in 0..5 {
                    firma vv: u8 = f[g * 7 + rr];
                    firma nn: u8 = (3 + cc) sicut u8;
                    firma lucet: u8 = (vv sursum nn) deorsum 7;
                    si lucet eq 1 {
                        per dy in 0..2 {
                            per dx in 0..2 {
                                firma px: mensura = ox + n * 12 + cc * 2 + dx;
                                firma py: mensura = base_y + rr * 2 + dy;
                                si px lt 160 {
                                    si py lt 100 {
                                        firma k: mensura = (py * 160 + px) * 3;
                                        (*fb)[k] = cr sicut u8;
                                        (*fb)[k + 1] = cg sicut u8;
                                        (*fb)[k + 2] = cb sicut u8;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            }
        }
    }
    redde semen;
}
