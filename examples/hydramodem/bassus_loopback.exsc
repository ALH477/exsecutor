// examples/hydramodem/bassus_loopback.exsc -- the bass-profile driver for
// dcf_loopback's frame, d310123400a1ffffdeadbeef0a1b2ca961, and the only file of
// its unit that names `Mundus`. It writes what HydraModem's frame_tx --profile
// bass writes for it:
// vendor/hydramodem-bicinium/bassus-d310123400a1ffffdeadbeef0a1b2ca961.wav, byte
// for byte (tests/programs/bassus_loopback/). Exit 0 when all 689,324 bytes were
// written, 1 otherwise.

publica functio initium(m: Mundus) -> u8 {
    firma a = m.ambitus();
    sub ambitus = a;
    firma s = Scriptor.ad_exitum(a);
    firma f = DeModFrame {
        signum: 0xd3,
        versio: 1,
        genus: 0,
        numerus: 0x1234,
        fons: 0x00a1,
        meta: 0xffff,
        onus: 0xdeadbeef,
        tempus: 0x0a1b2c,
        cursus: 0xa961
    };
    si bassus_modula(s, f sicut acies<u8, 17>) ne 689324 {
        redde 1;
    }
    redde 0;
}
