// examples/hydramodem/auditus.exsc -- the MUSICAL receiver: HydraModem's
// decode_window (hydra_modem.c) for the melody and bass voices, and so for the
// duet, which is the two of them in one burst. Pure: no `poscit`, no
// capability, no `initium`. The drivers (auditus_lege.exsc and the *_recipe.exsc
// files) read a WAV into an array of samples and hand it here by immutable
// borrow; this file decides the frame. docs/design/melos.md section 9 is the
// design.
//
// The reference is Punctim's hydramodem/ at f86f5d5: decode_window, which is
// profile-generic, run on hydra_profile_melody or hydra_profile_bass. Its
// output is a verdict, not bytes, so this receiver is held to verdicts, as
// receptor.exsc is (ADR 0014): the vendored WAVs decode to their frames, and
// words round-trip through the transmitter in one process.
//
// WHY NOT receptor.exsc's DESIGN. receptor.exsc keeps four prefix sums, one per
// (tone, I/Q), over the whole burst, so any window's energy is two
// subtractions. At 8 tones and the duet's 344,640 samples that is 16 x 344,641
// x 8 bytes = 44 MB, against an 8 MiB stack that nothing checks. What is
// stored here is the samples themselves, once, as f64 (2.76 MB, in the
// driver), and every window is integrated when it is needed. The acquisition
// scan, which wants a window at EVERY sample offset, uses the other property
// the profile guarantees: each tone completes a whole number of cycles in L =
// 1920 samples, so the window one sample on is a SLIDING DFT,
//
//     S(a + 1) = S(a) + (x[a + L] - x[a]) w(a),   w(a) = e^{-2 pi j h a / L},
//
// one multiply-add a tone a sample. It is recomputed from scratch once every L
// samples, so floating-point error never accumulates across more than one
// symbol. An energy is |S|^2, invariant under any fixed phase rotation, so the
// phase reference of each window is simply its own first sample.
//
// WHAT IS THE REFERENCE'S, STEP BY STEP. Acquisition scores every origin by how
// many of the known prefix symbols (preamble, then sync) have their known tone
// as the argmax, takes the CENTRE of the best-scoring plateau, then refines
// over +/- L/2 by the known prefix's total energy, first strict maximum. It
// gives up below nknown - 3 matches. Data symbols then run through the
// reference's timing loop: a +/- 2 sample search on the TOTAL energy, gated at
// 15 %, EMA 0.2, half the drift applied a symbol. hydra_modem.c's constants
// are used unchanged. Two things differ, both named:
//   - the soft bit is max E(bit 1) - max E(bit 0), NOT the reference's
//     normalised (max1 - max0)/(max1 + max0): receptor.exsc's choice and its
//     reason (receptor.md D7), and it needs no division per bit;
//   - the Viterbi and the residue are receptor.exsc's `decodifica` and
//     `residuum`, reused unchanged, so the soft bits are scaled to +/- 2^20 over
//     the frame, as that Viterbi's metric bound requires.
//
// Floating point is used where the reference uses it (the correlator, the
// energies, the timing loop); the Viterbi is receptor.exsc's integers.

// One streaming window: the longest voice (the bass, 178 x 1920) plus the
// reference streaming receiver's margin, 0.05 s + 4 symbols (hydra_rx_create:
// frame_len = body + 2400 + 7680). It holds any whole burst, the duet's
// 344,640 samples included, which is all the whole-file drivers need.
publica firma auditus_capacitas: mensura = 351840;
publica firma auditus_l: mensura = 1920;             // samples a symbol, both voices

// ---- the voices -------------------------------------------------------------
// vox 0 is the melody (hydra_profile_melody): 8 tones, 3 bits a symbol, 12
// preamble + 6 sync + 106 data = 124 symbols. vox 1 is the bass
// (hydra_profile_bass): 4 tones, 2 bits, 12 + 8 + 158 = 178. Drone and gain are
// transmit-only, so the duet's voices decode with these same two.

publica functio auditus_toni(vox: mensura) -> mensura {
    si vox eq 0 { redde 8; }
    redde 4;
}

publica functio auditus_bits(vox: mensura) -> mensura {
    si vox eq 0 { redde 3; }
    redde 2;
}

publica functio auditus_symbola(vox: mensura) -> mensura {
    si vox eq 0 { redde melos_symbola; }
    redde bassus_symbola;
}

// The known prefix: preamble and sync, whose symbols do not depend on the frame.
publica functio auditus_noti(vox: mensura) -> mensura {
    si vox eq 0 { redde 18; }
    redde 20;
}

publica functio auditus_harmonicus(vox: mensura, t: mensura) -> mensura {
    si vox eq 0 { redde melos_harmonicus(t); }
    redde bassus_harmonicus(t);
}

// Known symbol k (< auditus_noti): the transmitter's own `*_tonus`, which reads
// no frame bit below the data, so a zero frame and CRC are passed.
publica functio auditus_notus(vox: mensura, k: mensura) -> mensura {
    firma nihil: acies<u8, 17> = [0; 17];
    si vox eq 0 { redde melos_tonus(nihil, 0, k); }
    redde bassus_tonus(nihil, 0, k);
}

// ---- the sine --------------------------------------------------------------

// sin(2 pi k / 1920) for every k, from melos.exsc's quarter wave: the
// transmitter's own table, so both directions share one set of 481 values.
publica functio auditus_tabula() -> acies<f64, 1920> {
    firma q: acies<f64, 481> = melos_quadrans();
    mutabilis t: acies<f64, 1920> = [0.0; 1920];
    per k in 0..1920 {
        t[k] = melos_sinus(q, k);
    }
    redde t;
}

// A phase advanced by h, wrapped into 0..1919 (every h here is below 1920).
functio auditus_gradus(p: mensura, h: mensura) -> mensura {
    firma y: mensura = p + h;
    si y ge 1920 {
        redde y - 1920;
    }
    redde y;
}

// The energy of harmonic h over the window [a, a + L): integrate-and-dump, the
// matched filter, phase referenced to the window's first sample.
publica functio auditus_vis(x: &acies<f64, 351840>, s: &acies<f64, 1920>,
                            a: mensura, h: mensura) -> f64 {
    mutabilis re: f64 = 0.0;
    mutabilis im: f64 = 0.0;
    mutabilis p: mensura = 0;
    mutabilis c: mensura = 480;                       // cos x = sin(x + pi/2)
    per n in 0..1920 {
        firma v: f64 = (*x)[a + n];
        re = re + v * (*s)[c];
        im = im + v * (*s)[p];
        p = auditus_gradus(p, h);
        c = auditus_gradus(c, h);
    }
    redde re * re + im * im;
}

// ---- acquisition -----------------------------------------------------------

// The frame origin, or `n` when there is none (fewer than nknown - 3 matches,
// or a burst too short to hold the voice). The ARGMAX OF EVERY WINDOW is
// computed by the sliding DFT into `am`, one byte an origin; the known-prefix
// match then costs nknown comparisons an origin.
publica functio auditus_origo(x: &acies<f64, 351840>, s: &acies<f64, 1920>,
                              n: mensura, vox: mensura) -> mensura {
    firma nt = auditus_toni(vox);
    firma nk = auditus_noti(vox);
    firma span = auditus_symbola(vox) * 1920;
    // hydra_modem.c: need = total_syms x L, and the scan's last origin is n - need.
    // (A first draft asked for one symbol more; a +3000 ppm clock compresses the
    // duet's bass to 343,608 samples, under that bound and over this one, and the
    // comparison with the reference caught it: docs/design/melos.md section 9.)
    si n lt span {
        redde n;
    }
    mutabilis h: acies<mensura, 8> = [0; 8];
    per t in 0..nt {
        h[t] = auditus_harmonicus(vox, t);
    }
    mutabilis nota: acies<mensura, 20> = [0; 20];
    per k in 0..nk {
        nota[k] = auditus_notus(vox, k);
    }

    // argmax at every origin a in [0, n - L], by the sliding DFT
    firma na = n - 1920 + 1;
    mutabilis am: acies<u8, 351840> = [0; 351840];
    mutabilis re: acies<f64, 8> = [0.0; 8];
    mutabilis im: acies<f64, 8> = [0.0; 8];
    mutabilis ph: acies<mensura, 8> = [0; 8];         // phase of sample a, per tone
    mutabilis cyc: mensura = 0;
    per a in 0..na {
        si cyc eq 0 {
            // exact, once a symbol: no error outlives one window
            per t in 0..nt {
                mutabilis r: f64 = 0.0;
                mutabilis i: f64 = 0.0;
                mutabilis p: mensura = ph[t];
                mutabilis c: mensura = auditus_gradus(ph[t], 480);
                per m in 0..1920 {
                    firma v: f64 = (*x)[a + m];
                    r = r + v * (*s)[c];
                    i = i + v * (*s)[p];
                    p = auditus_gradus(p, h[t]);
                    c = auditus_gradus(c, h[t]);
                }
                re[t] = r;
                im[t] = i;
            }
        }
        mutabilis optimus: mensura = 0;
        mutabilis emax: f64 = -1.0;
        per t in 0..nt {
            firma e: f64 = re[t] * re[t] + im[t] * im[t];
            si e gt emax {                              // first strict max: argmax_d
                emax = e;
                optimus = t;
            }
        }
        am[a] = optimus sicut u8;
        // slide to a + 1 (only if that window exists)
        si a + 1 lt na {
            firma d: f64 = (*x)[a + 1920] - (*x)[a];
            per t in 0..nt {
                firma p = ph[t];
                re[t] = re[t] + d * (*s)[auditus_gradus(p, 480)];
                im[t] = im[t] + d * (*s)[p];
                ph[t] = auditus_gradus(p, h[t]);
            }
        }
        cyc = cyc + 1;
        si cyc eq 1920 {
            cyc = 0;
        }
    }

    // the plateau: every origin, the full known prefix
    firma ohi = n - span;
    mutabilis optima: mensura = 0;
    mutabilis primus: mensura = 0;
    mutabilis ultimus: mensura = 0;
    mutabilis inventa: u1 = 0;
    per o in 0..(ohi + 1) {
        mutabilis sc: mensura = 0;
        mutabilis w: mensura = o;
        per k in 0..nk {
            si (am[w] sicut mensura) eq nota[k] {
                sc = sc + 1;
            }
            w = w + 1920;
        }
        si inventa eq 0 {
            optima = sc; primus = o; ultimus = o; inventa = 1;
        } aliter {
            si sc gt optima {
                optima = sc; primus = o; ultimus = o;
            } aliter {
                // The plateau is the FIRST run: an origin more than a symbol
                // past its start is another burst's (hydra_modem.c, the same
                // rule since Punctim's streaming fix). One burst's plateau is
                // never a symbol wide, so for a single burst this is the old
                // first..last.
                si sc eq optima {
                    si o le primus + 1920 {
                        ultimus = o;
                    }
                }
            }
        }
    }
    mutabilis o: mensura = (primus + ultimus) deorsum 1;

    // fine phase: +/- L/2 by the known prefix's energy (a sharp peak), each known
    // window slid across the 1921 candidates
    mutabilis acc: acies<f64, 1921> = [0.0; 1921];
    mutabilis valida: acies<u8, 1921> = [0; 1921];
    per i in 0..1921 {
        si o + i ge 960 {
            firma base = o + i - 960;
            si base + nk * 1920 le n {
                valida[i] = 1;
            }
        }
    }
    per k in 0..nk {
        firma hk = h[nota[k]];
        mutabilis r: f64 = 0.0;
        mutabilis im2: f64 = 0.0;
        mutabilis p: mensura = 0;
        mutabilis viva: u1 = 0;                        // a window has been integrated
        per i in 0..1921 {
            si valida[i] eq 1 {
                firma a = o + i - 960 + k * 1920;
                si viva eq 0 {
                    r = 0.0; im2 = 0.0;
                    mutabilis pp: mensura = 0;
                    mutabilis cc: mensura = 480;
                    per m in 0..1920 {
                        firma v: f64 = (*x)[a + m];
                        r = r + v * (*s)[cc];
                        im2 = im2 + v * (*s)[pp];
                        pp = auditus_gradus(pp, hk);
                        cc = auditus_gradus(cc, hk);
                    }
                    p = 0;
                    viva = 1;
                }
                acc[i] = acc[i] + r * r + im2 * im2;
                // slide to the next candidate
                si i + 1 lt 1921 {
                    si valida[i + 1] eq 1 {
                        firma d: f64 = (*x)[a + 1920] - (*x)[a];
                        r = r + d * (*s)[auditus_gradus(p, 480)];
                        im2 = im2 + d * (*s)[p];
                        p = auditus_gradus(p, hk);
                    }
                }
            }
        }
    }
    mutabilis optimum: f64 = -1.0;
    mutabilis gradus: mensura = 960;                   // od = 0 unless refined
    per i in 0..1921 {
        si valida[i] eq 1 {
            si acc[i] gt optimum {
                optimum = acc[i];
                gradus = i;
            }
        }
    }
    si optima + 3 lt nk {
        // No complete burst. For a streaming window, look past the complete-burst
        // range for a known prefix whose burst runs off the window's end: the
        // first origin matching nknown - 3 of it. Reported as n + 1 + origin, so
        // the driver can replay from there instead of discarding a burst that a
        // false trigger started the window too early for. This runs only when the
        // reference's own scan has already failed, so no verdict changes.
        firma ultima = n - nk * 1920;
        per q in (ohi + 1)..(ultima + 1) {
            mutabilis sc: mensura = 0;
            mutabilis w: mensura = q;
            per k in 0..nk {
                si (am[w] sicut mensura) eq nota[k] {
                    sc = sc + 1;
                }
                w = w + 1920;
            }
            si sc + 3 ge nk {
                redde n + 1 + q;
            }
        }
        redde n;                                        // HYDRA_ERR_NO_SYNC
    }
    redde o + gradus - 960;
}

// ---- the data symbols ------------------------------------------------------

// The soft bits of the data symbols, deinterleaved and scaled for
// receptor.exsc's `decodifica` (+/- 2^20 over the frame), from the origin `o`
// on. `n` is returned in s[0]'s place never: a window that would run past the
// samples ends the frame early, and the zero soft bits it leaves decode to a
// CRC failure -- the reference's HYDRA_ERR_NO_SYNC, reported as 2 here, which
// the certificate never reaches (measured: every certified window lies inside).
publica functio auditus_mollia(x: &acies<f64, 351840>, s: &acies<f64, 1920>,
                               n: mensura, vox: mensura, o: mensura) -> acies<i64, 316> {
    firma nt = auditus_toni(vox);
    firma bps = auditus_bits(vox);
    firma nk = auditus_noti(vox);
    firma nd = auditus_symbola(vox) - nk;
    mutabilis h: acies<mensura, 8> = [0; 8];
    per t in 0..nt {
        h[t] = auditus_harmonicus(vox, t);
    }
    mutabilis crudi: acies<f64, 318> = [0.0; 318];    // interleaved order, raw
    mutabilis positio: f64 = ((o + nk * 1920) sicut f64);
    mutabilis vagatio: f64 = 0.0;
    mutabilis e5: acies<f64, 40> = [0.0; 40];          // 5 offsets x 8 tones
    per j in 0..nd {
        // a0 = lround(pos), pos >= 0
        mutabilis a0: mensura = positio sicut mensura;
        si positio - (a0 sicut f64) ge 0.5 {
            a0 = a0 + 1;
        }
        mutabilis emax: f64 = -1.0;
        mutabilis emin: f64 = 1.0e300;
        mutabilis optimus: mensura = 2;
        per oi in 0..5 {
            mutabilis e: f64 = -1.0;
            si a0 + oi ge 2 {
                firma aa = a0 + oi - 2;
                si aa + 1920 le n {
                    e = 0.0;
                    per t in 0..nt {
                        firma et = auditus_vis(x, s, aa, h[t]);
                        e5[oi * 8 + t] = et;
                        e = e + et;
                    }
                }
            }
            si e gt emax {
                emax = e;
                optimus = oi;
            }
            si e ge 0.0 {
                si e lt emin {
                    emin = e;
                }
            }
        }
        // the gate: only a straddled transition carries timing information
        mutabilis usus: mensura = 2;
        si emax gt 0.0 {
            si (emax - emin) gt 0.15 * emax {
                usus = optimus;
                vagatio = vagatio + 0.2 * (((usus sicut f64) - 2.0) - vagatio);
            }
        }
        positio = positio + 1920.0 + 0.5 * vagatio;
        si a0 + usus lt 2 {
            redde auditus_scala(crudi);
        }
        si a0 + usus - 2 + 1920 gt n {
            redde auditus_scala(crudi);
        }
        // max-log over the tones, bit by bit, MSB first
        per b in 0..bps {
            mutabilis m1: f64 = -1.0;
            mutabilis m0: f64 = -1.0;
            per t in 0..nt {
                firma y = t deorsum (bps - 1 - b);
                firma bit = y - ((y deorsum 1) sursum 1);
                firma et = e5[usus * 8 + t];
                si bit eq 1 {
                    si et gt m1 { m1 = et; }
                } aliter {
                    si et gt m0 { m0 = et; }
                }
            }
            crudi[j * bps + b] = m1 - m0;
        }
    }
    redde auditus_scala(crudi);
}

// Scale the frame's soft bits to +/- 2^20 and deinterleave them: interleaved
// bit d sits at coded position 19 d mod 316 (modulator.exsc's `intertexe`),
// walked. Bits 316 and 317, the melody's zero padding, are dropped.
functio auditus_scala(crudi: acies<f64, 318>) -> acies<i64, 316> {
    mutabilis maxima: f64 = 0.0;
    per d in 0..316 {
        mutabilis v: f64 = crudi[d];
        si v lt 0.0 { v = 0.0 - v; }
        si v gt maxima { maxima = v; }
    }
    mutabilis lin: acies<i64, 316> = [0; 316];
    si maxima eq 0.0 {
        redde lin;
    }
    firma f: f64 = 1048576.0 / maxima;
    mutabilis j: mensura = 0;
    per d in 0..316 {
        lin[j] = (crudi[d] * f) sicut i64;
        j = j + 19;
        si j ge 316 {
            j = j - 316;
        }
    }
    redde lin;
}

// ---- the verdict -----------------------------------------------------------

// One voice's verdict, with where its frame ends: `finis` is the origin plus
// the voice's symbols, the first sample after its body, so a streaming driver
// can consume exactly that much and keep what follows. status 0 decoded, 1 no
// sync, 2 CRC, 3 a burst STARTS at `finis` but runs past the window's end.
publica structura Auditum {
    status: u8
    frame: acies<u8, 17>
    finis: mensura
}

publica functio auditus_audi(x: &acies<f64, 351840>, n: mensura, vox: mensura) -> Auditum {
    mutabilis r = Auditum { status: 0, frame: [0; 17], finis: 0 };
    firma s: acies<f64, 1920> = auditus_tabula();
    firma o = auditus_origo(x, s, n, vox);
    si o eq n {
        r.status = 1;
        redde r;
    }
    si o gt n {
        // a burst starts at o - n - 1 but does not fit the window
        r.status = 3;
        r.finis = o - n - 1;
        redde r;
    }
    firma d = decodifica(auditus_mollia(x, s, n, vox, o));
    si residuum(d) ne 0 {
        r.status = 2;
        redde r;
    }
    per i in 0..17 {
        r.frame[i] = d[i];
    }
    r.finis = o + auditus_symbola(vox) * 1920;
    redde r;
}

// One voice from the samples: [status, frame bytes 0..16]. status 0 = decoded
// and the modem CRC's residue is zero; 1 = no sync; 2 = CRC. The frame bytes are
// meaningful only at status 0.
publica functio auditus_ausculta(x: &acies<f64, 351840>, n: mensura,
                                 vox: mensura) -> acies<u8, 18> {
    mutabilis r: acies<u8, 18> = [0; 18];
    firma s: acies<f64, 1920> = auditus_tabula();
    firma o = auditus_origo(x, s, n, vox);
    si o ge n {
        r[0] = 1;                                       // no complete burst
        redde r;
    }
    firma d = decodifica(auditus_mollia(x, s, n, vox, o));
    si residuum(d) ne 0 {
        r[0] = 2;
        redde r;
    }
    per i in 0..17 {
        r[i + 1] = d[i];
    }
    redde r;
}
