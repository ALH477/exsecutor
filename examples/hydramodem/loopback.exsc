// examples/hydramodem/loopback.exsc -- the driver for dcf_loopback's frame,
// d310123400a1ffffdeadbeef0a1b2ca961, and the only file of its unit that
// names `Mundus`. It writes the WAV HydraModem's frame_tx writes for this
// frame to standard output: vendor/hydramodem-tx/<the frame>.wav, byte for
// byte (tests/programs/hydramodem_loopback/).
//
// The frame is a DeModFrame, every field named, not seventeen loose bytes:
// the type says what the modem carries. `cursus` is the frame's own CRC,
// sealed upstream; the modem does not check it and does not recompute it.
// Exit 0 when all 38,060 bytes were written, 1 otherwise.

publica functio initium(m: Mundus) -> u8 {
    firma a = m.ambitus();
    sub ambitus = a;
    firma s = Scriptor.ad_exitum(a);
    firma f = DeModFrame {
        signum: 0xd3,
        versio: 1,
        genus: 0,
        numerus: 0x1234,
        fons: 0x00a1,
        meta: 0xffff,
        onus: 0xdeadbeef,
        tempus: 0x0a1b2c,
        cursus: 0xa961
    };
    si modula(s, f sicut acies<u8, 17>) ne 38060 {
        redde 1;
    }
    redde 0;
}
