publica functio melos_quadrans() -> acies<f64, 481> {
    firma m: acies<u64, 481> = melos_quadrans_integri();
    firma d: u64 = 2305843009213693952;       // 2^61
    firma dd: f64 = d sicut f64;
    mutabilis q: acies<f64, 481> = [0.0; 481];
    per k in 0..481 {
        q[k] = (m[k] sicut f64) / dd;
    }
    redde q;
}

// sin(2 pi k / 1920), 0 <= k < 1920, from the quarter wave -- qsin's fold:
// k > 960 is minus the value at k - 960; 480 < k <= 960 mirrors to 960 - k.
publica functio melos_sinus(q: acies<f64, 481>, k: mensura) -> f64 {
    si k gt 960 {
        firma j: mensura = k - 960;
        si j gt 480 {
            redde -q[960 - j];
        }
        redde -q[j];
    }
    si k gt 480 {
        redde q[960 - k];
    }
    redde q[k];
}

// ---- the sample ----------------------------------------------------------------

// The WAV writer's lround(z) (wav.c) for 0 <= z < 32767: the cast truncates,
// and the fraction z - n is exact below 2^52, so the comparison is exact and
// a half rounds up, away from zero.
functio melos_rotunda(z: f64) -> u16 {
    mutabilis n: u16 = z sicut u16;
    si z - (n sicut f64) ge 0.5 {
        n = n + 1;
    }
    redde n;
}

// One sample: the data carrier at phase a, the drones at b1 and b2 (all in
// 1920ths of a cycle), under the envelope e. The operations and their order
// are music_render's: v = gd x sin(a), then v + 0.12 x sin(b) for each drone
// in order, with gd = tx_gain - 2 x drone_gain computed as the reference
// computes it; then (float)(e x v), which is the sample the modem hands the
// WAV writer, and the writer's lround(s x 32767.0), symmetric about zero.
// |s| <= 0.9 so the writer's clamp never acts. A negative sample is its
// magnitude's two's complement.
publica functio melos_vox(q: acies<f64, 481>, a: mensura, b1: mensura, b2: mensura,
                          e: f64) -> u16 {
    firma gd: f64 = 0.9 - 2.0 * 0.12;
    mutabilis v: f64 = gd * melos_sinus(q, a);
    v = v + 0.12 * melos_sinus(q, b1);
    v = v + 0.12 * melos_sinus(q, b2);
    redde melos_scribibilis((e * v) sicut f32);
}

// The WAV writer's step, on the sample the modem hands it: lround(s x 32767.0)
// with s widened from f32 exactly as C promotes it. |s| <= 0.9 for every
// profile here, so the writer's clamp never acts.
publica functio melos_scribibilis(y: f32) -> u16 {
    firma z: f64 = (y sicut f64) * 32767.0;
    si z ge 0.0 {
        redde melos_rotunda(z);
    }
    redde 0 -% melos_rotunda(-z);
}

// One voice with no drone, as music_render computes it when a profile has none
// (the bass, and the melody voice of the duet): gd = tx_gain - 0 x 0.0, which is
// tx_gain exactly, so g is passed as the voice's tx_gain; then v = g x sin(a)
// and the voice's contribution (float)(e x v). Summing voices is the caller's.
publica functio melos_vox_simplex(q: acies<f64, 481>, g: f64, a: mensura, e: f64) -> f32 {
    firma v: f64 = g * melos_sinus(q, a);
    redde (e * v) sicut f32;
}

// The raised-cosine envelope over R = 480 samples: cos(2 pi (2i + 1) / 4R),
// which is sin at (2i + 1 + R) / 4R -- and 4R = 1920, so the same table.
// Attack: 0.5 - 0.5 cos; release: 0.5 + 0.5 cos. i < 480, so the index stays
// below 1440 and needs no wrap.
publica functio melos_ascensus(q: acies<f64, 481>, i: mensura) -> f64 {
    redde 0.5 - 0.5 * melos_sinus(q, i + i + 481);
}

publica functio melos_descensus(q: acies<f64, 481>, j: mensura) -> f64 {
    redde 0.5 + 0.5 * melos_sinus(q, j + j + 481);
}

// ---- the notes ------------------------------------------------------------------

// Symbol k plays harmonic H[k] of 25 Hz: hydra_profile_music puts scale degree
// d on symbol d xor (d >> 1), so pitch-adjacent notes differ in one bit.
// Degrees 24 27 30 36 40 48 54 60 land on symbols 0 1 3 2 6 7 5 4, which is
// this table read the other way. Symbol 0 is the tonic; symbol 7, the
// preamble's other note, its octave.
functio melos_harmonici() -> acies<mensura, 8> {
    redde [24, 27, 36, 30, 60, 54, 40, 48];
}

publica functio melos_harmonicus(k: mensura) -> mensura {
    firma h: acies<mensura, 8> = melos_harmonici();
    redde h[k];
}

// Three bits, most significant first, as one 8-FSK symbol
// (hydra_bits_to_symbols).
functio melos_triplex(b0: mensura, b1: mensura, b2: mensura) -> mensura {
    redde (b0 sursum 2) + (b1 sursum 1) + b2;
}

// Bit n of the sync field: the 16 bits of 0x2DD4 (modulator.exsc's
// synchronia), then zero padding to the sixth symbol's 18.
functio melos_synchronia(n: mensura) -> mensura {
    si n ge 16 {
        redde 0;
    }
    redde synchronia(n);
}

// Bit d of the interleaved coded stream (modulator.exsc's codificatum and
// intertexe, unchanged: the code and interleaver do not depend on the tone
// count), then zero padding to the 106th symbol's 318.
functio melos_datum(f: acies<u8, 17>, c: u16, d: mensura) -> mensura {
    si d ge 316 {
        redde 0;
    }
    si codificatum(f, c, intertexe(d)) eq 1 {
        redde 1;
    }
    redde 0;
}

// The symbol s (0 <= s < 124) of the frame f whose modem CRC is c: 12 preamble
// symbols alternating 0 and 7 (`k & 1 ? N - 1 : 0`), 6 sync symbols, then 106
// data symbols. hydra_frame_build packs the sync and the data separately,
// each zero-padded to whole symbols.
publica functio melos_tonus(f: acies<u8, 17>, c: u16, s: mensura) -> mensura {
    si s lt 12 {
        si praeambulum(s) eq 1 {
            redde 7;
        }
        redde 0;
    }
    si s lt 18 {
        firma n: mensura = (s - 12) + (s - 12) + (s - 12);
        redde melos_triplex(melos_synchronia(n), melos_synchronia(n + 1),
                            melos_synchronia(n + 2));
    }
    firma d: mensura = (s - 18) + (s - 18) + (s - 18);
    redde melos_triplex(melos_datum(f, c, d), melos_datum(f, c, d + 1),
                        melos_datum(f, c, d + 2));
}
