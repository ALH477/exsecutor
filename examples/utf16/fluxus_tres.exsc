// fluxus_tres.exsc -- UTF-8 to UTF-16 as a three-stage COMBINATIONAL lockstep
// pipeline, one input byte per tick.
//
// METHOD. Three stages, each a function, advanced together:
//
//   stage 1  classis            byte -> class code (Table 3-7's byte ranges,
//                               12 classes; cl_finis is the 13th and comes
//                               from the loop). Stateless, so it has no
//                               state struct; I did not invent one.
//   stage 2  assemblator        class + byte + Assemblatio (its own state) ->
//                               Eventus: ev_exspecta (need more), ev_scalaris
//                               (a complete scalar), or ev_malum (an ill-formed
//                               subpart: its length, and `repete`, whether the
//                               byte it was just handed was refused).
//   stage 3  scriptor_unitatum  scalar + Scriptio (the write cursor) -> one or
//                               two UTF-16 units written to scopus.
//
// COMBINATIONAL: in one tick the byte goes through all three stages in order,
// so stage 3 has written before the next byte is offered and no stage runs
// ahead of another. The policy is not a stage here: it is the branch in the
// tick loop between stage 2's event and stage 3 (strict returns; substitue
// hands U+FFFD to stage 3). fluxus_quattuor pulls it out into a stage.
//
// THE TICK LOOP AND THE RE-PRESENTED BYTE. Tick i < n offers byte i. Tick n is
// the flush tick: no byte, and the loop itself supplies the class cl_finis
// (there is nothing for stage 1 to classify), which tells stage 2 the stream
// ended; a pending sequence is then one maximal subpart. When a byte breaks a
// pending sequence, stage 2 emits ev_malum with repete = 1 and resets itself
// to idle. The loop acts on the event and does NOT advance i: the next tick
// offers the same byte to stage 1 again and the now idle stage 2 takes it as
// the start of whatever comes next. Lockstep survives because a re-presentation
// is an extra tick, not a stage running twice: every tick runs stage 1, 2, 3
// once each, in order. It cannot repeat forever: an idle stage 2 never sets
// repete. Measured on 543,648 inputs: ticks = n + r + 1, r the number of
// re-presented bytes.
//
// WHERE THE MAXIMAL SUBPART COMES FROM. `ate` counts the bytes assembled so
// far, lead included. When a byte is refused, or the flush tick arrives, those
// `ate` bytes ARE the maximal subpart: they were a well-formed prefix and the
// refused byte may not extend it. A continuation is accepted only if its class
// bit is set in `permissum`, which encodes Table 3-7: after E0 only class
// cl_cont_c (A0..BF), after ED only a and b (80..9F), after F0 b and c
// (90..BF), after F4 only a (80..8F), otherwise a, b and c; after the first
// continuation it is back to all three. The subpart's first byte is not stored:
// the loop derives it as (offset after the subpart) - (length).
//
// NOT SHARED WITH ramus. No inner loop over fons[i + ate], and no lo/hi byte
// comparison for continuations (the range test is a bit test on a class mask).
// fons is read once per tick at the front and never looked ahead. The decoder
// state lives in structs that survive from tick to tick, not in locals of one
// loop iteration, and the stages are separate functions. Shared with ramus
// because it is the standard and not a design choice: Table 3-7 itself and the
// surrogate arithmetic.

// ---- stage 1 vocabulary: the class of a byte -------------------------------

firma cl_ascii: u8 = 0;
firma cl_cont_a: u8 = 1;
firma cl_cont_b: u8 = 2;
firma cl_cont_c: u8 = 3;
firma cl_malus: u8 = 4;
firma cl_duo: u8 = 5;
firma cl_e0: u8 = 6;
firma cl_tres: u8 = 7;
firma cl_ed: u8 = 8;
firma cl_f0: u8 = 9;
firma cl_quattuor: u8 = 10;
firma cl_f4: u8 = 11;
firma cl_finis: u8 = 12;

// ---- stage 2 vocabulary: events --------------------------------------------

firma ev_exspecta: u8 = 0;
firma ev_scalaris: u8 = 1;
firma ev_malum: u8 = 2;

// Bit k of a `permissum` mask says: a byte of class k may be the next
// continuation. Classes 1, 2, 3 are the three continuation ranges.
firma perm_omnes: u32 = 14;
firma perm_e0: u32 = 8;
firma perm_ed: u32 = 6;
firma perm_f0: u32 = 12;
firma perm_f4: u32 = 2;

structura Eventus {
    genus: u8
    cp: u32
    longitudo: mensura
    repete: u8
}

structura Assemblatio {
    cp: u32
    opus: mensura
    ate: mensura
    permissum: u32
}

structura Scriptio {
    j: mensura
}

functio fac_eventum(genus: u8, cp: u32, longitudo: mensura, repete: u8) -> Eventus {
    redde Eventus { genus: genus, cp: cp, longitudo: longitudo, repete: repete };
}

// STAGE 1. A byte in, a class out. Nothing else about the stream matters.
functio classis(b: u8) -> u8 {
    si b lt 0x80 {
        redde cl_ascii;
    }
    si b lt 0x90 {
        redde cl_cont_a;
    }
    si b lt 0xA0 {
        redde cl_cont_b;
    }
    si b lt 0xC0 {
        redde cl_cont_c;
    }
    si b lt 0xC2 {
        redde cl_malus;
    }
    si b lt 0xE0 {
        redde cl_duo;
    }
    si b eq 0xE0 {
        redde cl_e0;
    }
    si b eq 0xED {
        redde cl_ed;
    }
    si b lt 0xF0 {
        redde cl_tres;
    }
    si b eq 0xF0 {
        redde cl_f0;
    }
    si b lt 0xF4 {
        redde cl_quattuor;
    }
    si b eq 0xF4 {
        redde cl_f4;
    }
    redde cl_malus;
}

// STAGE 2. Class + byte + its own state in, one event out.
functio assemblator(cl: u8, b: u8, st: &mutabilis Assemblatio) -> Eventus {
    si (*st).opus gt 0 {
        si cl eq cl_finis {
            firma l: mensura = (*st).ate;
            (*st).opus = 0;
            (*st).ate = 0;
            redde fac_eventum(ev_malum, 0, l, 0);
        }
        si cl ge cl_cont_a et cl le cl_cont_c et (((*st).permissum deorsum (cl sicut u32)) atque 1) eq 1 {
            (*st).cp = ((*st).cp sursum 6) sive (b atque 0x3F) sicut u32;
            (*st).opus = (*st).opus - 1;
            (*st).ate = (*st).ate + 1;
            (*st).permissum = perm_omnes;
            si (*st).opus eq 0 {
                firma cp: u32 = (*st).cp;
                (*st).ate = 0;
                redde fac_eventum(ev_scalaris, cp, 0, 0);
            }
            redde fac_eventum(ev_exspecta, 0, 0, 0);
        }
        firma l: mensura = (*st).ate;
        (*st).opus = 0;
        (*st).ate = 0;
        redde fac_eventum(ev_malum, 0, l, 1);
    }

    si cl eq cl_finis {
        redde fac_eventum(ev_exspecta, 0, 0, 0);
    }
    si cl eq cl_ascii {
        redde fac_eventum(ev_scalaris, b sicut u32, 0, 0);
    }

    mutabilis opus: mensura = 0;
    mutabilis masca: u8 = 0;
    mutabilis perm: u32 = perm_omnes;
    si cl eq cl_duo {
        opus = 1;
        masca = 0x1F;
    } sin cl eq cl_e0 {
        opus = 2;
        masca = 0x0F;
        perm = perm_e0;
    } sin cl eq cl_ed {
        opus = 2;
        masca = 0x0F;
        perm = perm_ed;
    } sin cl eq cl_tres {
        opus = 2;
        masca = 0x0F;
    } sin cl eq cl_f0 {
        opus = 3;
        masca = 0x07;
        perm = perm_f0;
    } sin cl eq cl_f4 {
        opus = 3;
        masca = 0x07;
        perm = perm_f4;
    } sin cl eq cl_quattuor {
        opus = 3;
        masca = 0x07;
    }
    si opus eq 0 {
        // a stray continuation or an ill-formed lead: one byte, and it is consumed
        redde fac_eventum(ev_malum, 0, 1, 0);
    }
    (*st).opus = opus;
    (*st).ate = 1;
    (*st).cp = (b atque masca) sicut u32;
    (*st).permissum = perm;
    redde fac_eventum(ev_exspecta, 0, 0, 0);
}

// STAGE 3. A scalar in, one or two UTF-16 units out, at the write cursor.
functio scriptor_unitatum(cp: u32, st: &mutabilis Scriptio, scopus: &mutabilis acies<u16, 4096>) {
    si cp lt 0x10000 {
        (*scopus)[(*st).j] = cp sicut u16;
        (*st).j = (*st).j + 1;
    } aliter {
        firma v: u32 = cp - 0x10000;
        (*scopus)[(*st).j] = (0xD800 + (v deorsum 10)) sicut u16;
        (*scopus)[(*st).j + 1] = (0xDC00 + (v atque 0x3FF)) sicut u16;
        (*st).j = (*st).j + 2;
    }
}

publica functio converte(fons: acies<u8, 4096>, n: mensura,
                         scopus: &mutabilis acies<u16, 4096>, modus: u8) -> Exitus {
    mutabilis asm: Assemblatio = Assemblatio { cp: 0, opus: 0, ate: 0, permissum: perm_omnes };
    mutabilis scr: Scriptio = Scriptio { j: 0 };
    mutabilis i: mensura = 0;
    // Tick i < n offers byte i. Tick n is the flush tick: no byte, class cl_finis.
    dum i le n {
        mutabilis b: u8 = 0;
        mutabilis cl: u8 = cl_finis;
        si i lt n {
            b = fons[i];
            cl = classis(b);
        }
        firma ev: Eventus = assemblator(cl, b, asm);
        si ev.genus eq ev_scalaris {
            scriptor_unitatum(ev.cp, scr, scopus);
        } sin ev.genus eq ev_malum {
            // the subpart ends just before this byte if the byte was refused,
            // after it if the byte was part of the subpart (or on the flush tick)
            mutabilis finis: mensura = i;
            si i lt n et ev.repete eq 0 {
                finis = i + 1;
            }
            si modus eq modus_stricte {
                redde Exitus { unitates: scr.j, status: status_malformatum, positio: finis - ev.longitudo };
            }
            scriptor_unitatum(0xFFFD, scr, scopus);
        }
        si ev.repete eq 0 {
            i = i + 1;
        }
    }
    redde Exitus { unitates: scr.j, status: status_bene, positio: 0 };
}
