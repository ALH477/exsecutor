// recursio.exsc -- UTF-8 to UTF-16 by RECURSION: one call per sequence.
//
// `gradus` handles exactly one UTF-8 sequence (well-formed, or one maximal
// ill-formed subpart): it has `una_sequentia` decode it, writes the unit(s) it
// made (or U+FFFD, or records the strict-mode error), advances the cursor, and
// then CALLS ITSELF for the rest of the input. There is no loop over the input
// anywhere in this file. The one loop is inside `una_sequentia`, which is not
// recursive and consumes only the continuation bytes of the single sequence in
// hand (at most three).
//
// Everything that survives from one call to the next lives in a `Cursor`,
// passed down as `&mutabilis`: input position, output index, input length, the
// mode, and the offset of a strict-mode error. The recursion ends when the
// input is exhausted (every call returns 0) or a strict error is found (that
// call records the offset in the cursor and returns 1, and every caller passes
// the 1 up); `converte` reads the verdict from the value it gets back.
//
// WHERE THE MAXIMAL SUBPART COMES FROM. `una_sequentia` counts the bytes of its
// sequence it has accepted (`ate`, lead included) while it walks the
// continuation bytes. A continuation byte out of the range allowed for its
// position, or the end of input, stops the walk; what has been accepted is
// then a well-formed prefix that the next byte may not extend, i.e. the maximal
// subpart. The failing byte is NOT consumed: the recursive call starts there.
// A lead that cannot begin any well-formed sequence (80..C1, F5..FF) accepts
// one byte, itself.
//
// WHAT THIS DOES NOT SHARE WITH ramus. The lead byte is classified by a helper
// that returns one packed word (continuations needed, the bounds of the first
// continuation, the payload mask: four byte-wide fields) instead of ramus's
// inline branch chain; the decoded sequence comes back as one packed word too;
// and control flow is recursive where ramus's is `dum`. The continuation walk
// is the same idea as ramus's. Table 3-7 is the same table.
//
// STACK. Depth equals the number of sequences, so up to 4096 frames (4096 ASCII
// bytes, or 4096 ill-formed bytes in `modus_substitue`). exsc gives every
// temporary its own stack slot, so a frame is as big as its function has
// temporaries, and the first version of this file, with the whole decode inline
// in `gradus`, had a 1168-byte frame (1184 with saved rbp and return address):
// 4096 ASCII bytes needed more than 4608 KB of stack and ran in 5120 KB. The
// file as it stands keeps the classifier, the continuation walk and the unit
// writer in helpers that return before the recursive call, and `gradus` is left
// with `sub rsp, 400` (416 bytes per level with rbp and the return address).
// Measured, by bisecting `ulimit -s` on the built ELF: 4096 ASCII bytes need
// 1696 KB, 4096 bytes of 0xFF in `modus_substitue` need 1696 KB, against 28 KB
// for ramus on the same input, so about 417 bytes per level. The default
// limit is 8192 KB; under 1696 KB the same ELF dies with SIGSEGV at depth
// 4096. No per-chunk fallback was needed. A target with a smaller stack than
// that would need one, and none was tried here.

structura Cursor {
    i: mensura
    j: mensura
    n: mensura
    modus: u8
    ubi: mensura
}

// Lead byte -> packed word: bits 0..7 the continuations still needed (0 for
// an ill-formed lead), bits 8..15 the lowest allowed first continuation, bits
// 16..23 the highest, bits 24..31 the mask that takes the payload from the lead.
functio classis(b0: u8) -> u32 {
    si b0 ge 0xC2 et b0 le 0xDF {
        redde 0x1FBF8001;
    }
    si b0 eq 0xE0 {
        redde 0x0FBFA002;
    }
    si b0 eq 0xED {
        redde 0x0F9F8002;
    }
    si b0 ge 0xE1 et b0 le 0xEF {
        redde 0x0FBF8002;
    }
    si b0 eq 0xF0 {
        redde 0x07BF9003;
    }
    si b0 eq 0xF4 {
        redde 0x078F8003;
    }
    si b0 ge 0xF1 et b0 le 0xF3 {
        redde 0x07BF8003;
    }
    redde 0;
}

functio scribe(scopus: &mutabilis acies<u16, 4096>, j: mensura, cp: u32) -> mensura {
    si cp lt 0x10000 {
        (*scopus)[j] = cp sicut u16;
        redde j + 1;
    }
    firma v: u32 = cp - 0x10000;
    (*scopus)[j] = (0xD800 + (v deorsum 10)) sicut u16;
    (*scopus)[j + 1] = (0xDC00 + (v atque 0x3FF)) sicut u16;
    redde j + 2;
}

// The sequence at fons[i], decoded without recursion. Answers one word:
// bit 0 set if it was well-formed, bits 1..3 the bytes it covers (for an
// ill-formed one, the maximal subpart), bits 8.. the scalar (well-formed only).
// This is the one loop of the file: it consumes THIS sequence's continuation
// bytes, never more than three.
functio una_sequentia(fons: acies<u8, 4096>, i: mensura, n: mensura) -> u32 {
    firma b0: u8 = fons[i];
    si b0 lt 0x80 {
        redde ((b0 sicut u32) sursum 8) sive 3;
    }
    firma k: u32 = classis(b0);
    firma opus: mensura = (k atque 0xFF) sicut mensura;
    mutabilis lo: u8 = ((k deorsum 8) atque 0xFF) sicut u8;
    mutabilis hi: u8 = ((k deorsum 16) atque 0xFF) sicut u8;
    mutabilis cp: u32 = (b0 sicut u32) atque (k deorsum 24);

    // `ate`: bytes of this sequence accepted so far, the lead included.
    mutabilis ate: mensura = 1;
    mutabilis bonum: u8 = 1;
    si opus eq 0 {
        bonum = 0;
    }
    dum bonum eq 1 et ate le opus {
        si i + ate ge n {
            bonum = 0;
        } aliter {
            firma b: u8 = fons[i + ate];
            si b lt lo vel b gt hi {
                bonum = 0;
            } aliter {
                cp = (cp sursum 6) sive ((b atque 0x3F) sicut u32);
                lo = 0x80;
                hi = 0xBF;
                ate = ate + 1;
            }
        }
    }
    firma tegit: u32 = (ate sicut u32) sursum 1;
    si bonum eq 1 {
        redde (cp sursum 8) sive tegit sive 1;
    }
    redde tegit;
}

// One sequence, then the rest. Returns when the input is used up or a strict
// error has been recorded in the cursor.
functio gradus(fons: acies<u8, 4096>, scopus: &mutabilis acies<u16, 4096>,
               c: &mutabilis Cursor) -> u8 {
    firma i: mensura = (*c).i;
    si i ge (*c).n {
        redde 0;
    }
    firma r: u32 = una_sequentia(fons, i, (*c).n);
    si (r atque 1) eq 1 {
        (*c).j = scribe(scopus, (*c).j, r deorsum 8);
    } sin (*c).modus eq modus_stricte {
        (*c).ubi = i;
        redde 1;
    } aliter {
        (*scopus)[(*c).j] = 0xFFFD;
        (*c).j = (*c).j + 1;
    }
    (*c).i = i + (((r deorsum 1) atque 7) sicut mensura);
    redde gradus(fons, scopus, c);
}

publica functio converte(fons: acies<u8, 4096>, n: mensura,
                         scopus: &mutabilis acies<u16, 4096>, modus: u8) -> Exitus {
    mutabilis c: Cursor = Cursor { i: 0, j: 0, n: n, modus: modus, ubi: 0 };
    firma r: u8 = gradus(fons, scopus, c);
    si r eq 1 {
        redde Exitus { unitates: c.j, status: status_malformatum, positio: c.ubi };
    }
    redde Exitus { unitates: c.j, status: status_bene, positio: 0 };
}
