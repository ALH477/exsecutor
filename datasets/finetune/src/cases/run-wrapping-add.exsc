//! task: write
//! ask: Add 200 to 100 as u8 with wrapping arithmetic and return the result.
//! expect: exit=44
//! refs: §5.4, §8.4
//! explain: `+%` wraps modulo 2^8: 100 + 200 = 300, and 300 - 256 = 44. The same sum with plain `+` traps, and with `+|` saturates at 255.

functio circum(a: u8) -> u8 {
    redde a +% 200;
}

publica functio initium(m: Mundus) -> u8 {
    redde circum(100);
}
