#!/bin/sh
# The README gate. Refuses a commit when a claim in .trvthnvke.toml's
# gated docs no longer verifies (see CONTRIBUTING.md, "The README gate").
#
# Install with:
#   cp hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# or, once TrvthNvke is on PATH:
#   trvthnvke install-hook
#
# Upstream's hook is these two `exec`s and nothing else. The branch below is
# added deliberately and changes no policy: if TrvthNvke is absent the commit
# is still REFUSED -- a gate that skips itself when its tool is missing is the
# "check that is never run", and this tree treats that as indistinguishable
# from no check at all -- but it is refused with a sentence instead of a
# Python ModuleNotFoundError traceback, which is what a contributor who
# installed the hook and not the tool would otherwise have to decode.
if command -v trvthnvke >/dev/null 2>&1; then
  exec trvthnvke verify --fail
fi
if python3 -c 'import trvthnvke' >/dev/null 2>&1; then
  exec python3 -m trvthnvke verify --fail
fi
# The tool is a flake input (flake.nix), so a commit made outside `nix
# develop` can still be gated by entering it for the one command. Slower by
# the shell's start-up, and still a refusal -- never a skip -- if nix or the
# flake is missing.
if command -v nix >/dev/null 2>&1 && [ -f flake.nix ]; then
  exec nix develop -c trvthnvke verify --fail
fi
echo "pre-commit: the README gate cannot run -- TrvthNvke is not installed." >&2
echo "  Install it (see CONTRIBUTING.md, \"The README gate\"), or remove" >&2
echo "  .git/hooks/pre-commit if you do not want the gate locally. CI runs it" >&2
echo "  either way, so skipping here only moves the failure later." >&2
exit 1
