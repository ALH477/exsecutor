LEX_ROOT_GLOSS_LEN = $ - lex_root_gloss

; ---- suffixes, §3.4 table order ------------------------------------------------
lex_suffix_text:
	db	2,'-e'
	db	3,'-or'
	db	7,'-ibilis'
	db	3,'-io'
	db	3,'-us'
	db	6,'-orium'
LEX_SUFFIX_TEXT_LEN = $ - lex_suffix_text

lex_suffix_stem_sel:
	db	LEX_STEM_IMPERATIVE	; -e
	db	LEX_STEM_SUPINE	; -or
	db	LEX_STEM_PRESENT	; -ibilis
	db	LEX_STEM_SUPINE	; -io
	db	LEX_STEM_SUPINE	; -us
	db	LEX_STEM_SUPINE	; -orium

lex_suffix_kind_class:
	db	LEXKIND_FN	; -e -> functio
	db	LEXKIND_STRUCT	; -or -> structura
	db	LEXKIND_IFACE	; -ibilis -> interfacies
	db	LEXKIND_STRUCT	; -io -> structura
	db	LEXKIND_TYPUS	; -us -> typus
	db	LEXKIND_STRUCT	; -orium -> structura

; ---- prefixes, §3.5 table order (`prae-`,`sub-` expanded) ----------------------
lex_prefix_text:
	db	3,'re-'
	db	3,'de-'
	db	3,'ex-'
	db	3,'in-'
	db	6,'trans-'
	db	4,'con-'
	db	5,'prae-'
	db	4,'sub-'
LEX_PREFIX_TEXT_LEN = $ - lex_prefix_text

lex_prefix_law:
	db	LEXLAW_SAME_SIG	; re- (same signature as the bare form)
	db	LEXLAW_RETURN_TO_PARAM	; de- (base's return type becomes first parameter)
	db	LEXLAW_SRC_PARAM	; ex- (first parameter is the source type)
	db	LEXLAW_DST_PARAM	; in- (first parameter is the destination type)
	db	LEXLAW_DIFFER	; trans- (parameter and return types differ)
	db	LEXLAW_ARITY2	; con- (takes two or more of the base's operand type)
	db	LEXLAW_POSITIONAL	; prae- (positional only)
	db	LEXLAW_POSITIONAL	; sub- (positional only)
