LEX_ROOT_COUNT = 14
LEX_SUFFIX_COUNT = 6
LEX_PREFIX_COUNT = 8

; ---- prefix-law codes -------------------------------------------------------
; 0 is never a real law (NONE is not emitted by any table row); a law field
; holding 0 would be a bug in this generator, not a a valid "no law" answer --
; `prae-`/`sub-`'s "positional only" is its OWN code, POSITIONAL, precisely so
; that 0 stays free as an internal-only sentinel.
LEXLAW_NONE = 0
LEXLAW_SAME_SIG = 1
LEXLAW_RETURN_TO_PARAM = 2
LEXLAW_SRC_PARAM = 3
LEXLAW_DST_PARAM = 4
LEXLAW_DIFFER = 5
LEXLAW_ARITY2 = 6
LEXLAW_POSITIONAL = 7

; ---- declared-kind classes (§3.4's "must declare" column) -----------------
LEXKIND_NONE = 0
LEXKIND_FN = 1
LEXKIND_STRUCT = 2
LEXKIND_IFACE = 3
LEXKIND_TYPUS = 4

; ---- stem selectors ----------------------------------------------------------
; PRESENT/SUPINE match a suffix's stated stem literally, concatenated with the
; suffix's own text. IMPERATIVE (finding 17, `-e` only) matches the WHOLE
; remainder against a root's precomputed imperative form instead -- see
; lex_root_imperative below and this file's header.
LEX_STEM_PRESENT = 0
LEX_STEM_SUPINE = 1
LEX_STEM_IMPERATIVE = 2

; ---- roots, §3.3 table order --------------------------------------------------
lex_root_present:
	db	3,'leg'
	db	5,'scrib'
	db	3,'sec'
	db	4,'plic'
	db	5,'numer'
	db	5,'ordin'
	db	4,'sequ'
	db	3,'cap'
	db	3,'pon'
	db	3,'ten'
	db	4,'vert'
	db	4,'mitt'
	db	4,'iung'
	db	4,'solv'
LEX_ROOT_PRESENT_LEN = $ - lex_root_present

lex_root_supine:
	db	4,'lect'
	db	6,'script'
	db	4,'sect'
	db	6,'plicat'
	db	7,'numerat'
	db	7,'ordinat'
	db	5,'secut'
	db	4,'capt'
	db	5,'posit'
	db	4,'tent'
	db	4,'vers'
	db	4,'miss'
	db	5,'iunct'
	db	5,'solut'
LEX_ROOT_SUPINE_LEN = $ - lex_root_supine

lex_root_imperative:
	db	4,'lege'
	db	0,''
	db	0,''
	db	0,''
	db	0,''
	db	0,''
	db	0,''
	db	0,''
	db	0,''
	db	0,''
	db	0,''
	db	0,''
	db	0,''
	db	0,''
LEX_ROOT_IMPERATIVE_LEN = $ - lex_root_imperative

lex_root_gloss:
	db	4,'read'
	db	5,'write'
	db	3,'cut'
	db	4,'fold'
	db	5,'count'
	db	5,'order'
	db	6,'follow'
	db	4,'take'
	db	5,'place'
